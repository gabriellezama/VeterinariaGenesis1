@code {
    [Parameter] public Guid MascotaId { get; set; }
    
    private Mascota? mascota;
    private Cliente? cliente;
    private List<LineaTiempoItemDto> eventos = new();
    private bool mostrarModal = false;
    private bool mostrarModalEditarMascota = false;
    private EventoMedicoRequest nuevoEvento = new();
    private Guid? eventoEditandoId = null;
    private bool isSaving = false;
    private string errorModal = "";
    private LineaTiempoItemDto? eventoAImprimir;

    private void AbrirModalEditarMascota() => mostrarModalEditarMascota = true;

    private async Task GuardarCambiosMascota()
    {
        if (mascota == null) return;
        isSaving = true;
        var exito = await AppState.UpdateMascotaAsync(mascota);
        if (exito) mostrarModalEditarMascota = false;
        isSaving = false;
    }

    protected override async Task OnInitializedAsync()
    {
        AppState.OnChange += StateHasChanged;
        await CargarDatos();
        await AppState.LoadTrabajadoresAsync();
    }

    private async Task CargarDatos()
    {
        await AppState.LoadMascotasAsync();
        mascota = AppState.Mascotas.FirstOrDefault(m => m.Id == MascotaId);
        
        if (mascota != null)
        {
            await AppState.LoadClientesAsync();
            cliente = AppState.Clientes.FirstOrDefault(c => c.Id == mascota.ClienteId);
            eventos = await AppState.GetHistorialClinicoAsync(mascota.Id);
        }
    }

    private void AbrirModal()
    {
        eventoEditandoId = null;
        nuevoEvento = new EventoMedicoRequest { MascotaId = MascotaId, Fecha = DateTime.Now };
        errorModal = "";
        mostrarModal = true;
    }

    private void AbrirModalEditar(LineaTiempoItemDto item)
    {
        eventoEditandoId = item.Id;
        // Extraer título del formato [Titulo] descripcion
        var titulo = item.Titulo;
        var descripcion = item.Descripcion ?? "";
        if (descripcion.StartsWith("[") && descripcion.Contains("]"))
        {
            int end = descripcion.IndexOf("]");
            titulo = descripcion.Substring(1, end - 1);
            descripcion = descripcion.Substring(end + 2).TrimStart();
        }

        Enum.TryParse<TipoEventoMedico>(item.TipoEvento, out var tipo);

        nuevoEvento = new EventoMedicoRequest
        {
            MascotaId = MascotaId,
            Fecha = item.Fecha,
            Tipo = tipo,
            Titulo = titulo,
            Descripcion = descripcion,
            MedicoResponsable = item.MedicoResponsable ?? "",
            Costo = item.Costo
        };
        errorModal = "";
        mostrarModal = true;
    }

    private void CerrarModal() => mostrarModal = false;

    private async Task GuardarEvento()
    {
        if (string.IsNullOrEmpty(nuevoEvento.MedicoResponsable))
        {
            errorModal = "Debe seleccionar un médico responsable.";
            return;
        }

        if (string.IsNullOrEmpty(nuevoEvento.Titulo))
        {
            errorModal = "Debe indicar el motivo de la consulta.";
            return;
        }

        isSaving = true;
        errorModal = "";
        
        bool exito;
        if (eventoEditandoId.HasValue)
        {
            exito = await AppState.UpdateEventoMedicoAsync(eventoEditandoId.Value, nuevoEvento);
        }
        else
        {
            exito = await AppState.AddEventoMedicoAsync(nuevoEvento);
        }

        if (exito)
        {
            mostrarModal = false;
            eventoEditandoId = null;
            await CargarDatos();
        }
        else
        {
            errorModal = "Error al conectar con el servidor. Verifique su conexión e intente de nuevo.";
        }
        isSaving = false;
    }

    private async Task Imprimir() => await JS.InvokeVoidAsync("imprimirDocumento");

    private async Task EliminarEvento(LineaTiempoItemDto item)
    {
        var confirmado = await JS.InvokeAsync<bool>("confirm", $"¿Eliminar el registro '{item.Titulo}'? Esta acción no se puede deshacer.");
        if (confirmado)
        {
            await AppState.DeleteEventoMedicoAsync(item.Id);
            await CargarDatos();
        }
    }

    private async Task ImprimirReceta(LineaTiempoItemDto item)
    {
        eventoAImprimir = item;
        StateHasChanged();
        await Task.Delay(200);
        await JS.InvokeVoidAsync("imprimirDocumento");
        eventoAImprimir = null;
    }

    private void Volver() => NavigationManager.NavigateTo("clientes");

    public void Dispose() => AppState.OnChange -= StateHasChanged;

    public class EventoMedicoRequest
    {
        public Guid MascotaId { get; set; }
        public DateTime Fecha { get; set; } = DateTime.Now;
        public TipoEventoMedico Tipo { get; set; } = TipoEventoMedico.Consulta;
        public string Titulo { get; set; } = string.Empty;
        public decimal Costo { get; set; }
        public string Descripcion { get; set; } = string.Empty;
        public string MedicoResponsable { get; set; } = string.Empty;
        public string InfoExtra1 { get; set; } = string.Empty;
        public string InfoExtra2 { get; set; } = string.Empty;
        public DateTime? ProximaDosis { get; set; }
    }
}
