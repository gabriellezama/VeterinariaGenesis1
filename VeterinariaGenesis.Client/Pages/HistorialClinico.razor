@page "/historial-clinico/{mascotaId:guid}"
@using VeterinariaGenesis.Client.Services
@using VeterinariaGenesis.Domain.Entities
@using VeterinariaGenesis.Domain.Enums
@using VeterinariaGenesis.Application.DTOs
@inject AppStateService AppState
@inject NavigationManager NavigationManager
@inject IJSRuntime JS
@implements IDisposable

<PageTitle>Historial Clínico | Veterinaria Génesis</PageTitle>

<div class="no-print">
    <div class="mb-8 flex justify-between items-center">
        <div>
            <button @onclick="Volver" class="text-slate-400 hover:text-indigo-600 mb-2 flex items-center transition-colors font-bold text-sm">
                <i class="fas fa-arrow-left mr-2"></i> VOLVER A CLIENTES
            </button>
            <h1 class="text-3xl font-black text-slate-800 tracking-tighter">Historial Clínico</h1>
        </div>
        
        <div class="flex gap-3">
            <button @onclick="Imprimir" class="bg-white text-slate-600 px-6 py-3 rounded-2xl shadow-sm border border-slate-100 font-bold hover:bg-slate-50 transition-all flex items-center">
                <i class="fas fa-file-pdf mr-2 text-red-500"></i> DESCARGAR PDF
            </button>
            <button @onclick="AbrirModal" class="bg-indigo-600 hover:bg-indigo-700 text-white px-8 py-3 rounded-2xl shadow-xl shadow-indigo-100 font-black transition-all flex items-center transform hover:-translate-y-1">
                <i class="fas fa-plus-circle mr-2"></i> NUEVA ENTRADA
            </button>
        </div>
    </div>

    @if (mascota != null)
    {
        <!-- Cabecera de Mascota -->
        <div class="bg-white rounded-[2.5rem] p-8 shadow-2xl shadow-slate-200/50 border border-slate-50 mb-10 relative overflow-hidden no-print">
            <div class="absolute top-0 right-0 p-12 opacity-5 pointer-events-none">
                <i class="fas fa-paw text-9xl"></i>
            </div>
            
            <div class="flex flex-col md:flex-row gap-10 items-center relative z-10">
                <div class="w-40 h-40 bg-gradient-to-br from-indigo-500 to-purple-600 rounded-full flex items-center justify-center text-white text-6xl shadow-2xl shadow-indigo-200 border-8 border-white">
                    <i class="fas @(mascota.Especie?.ToLower() == "gato" ? "fa-cat" : "fa-dog")"></i>
                </div>
                
                <div class="flex-1 text-center md:text-left">
                    <div class="flex flex-col md:flex-row md:items-center gap-4 mb-4">
                        <h2 class="text-5xl font-black text-slate-800 tracking-tighter">@mascota.Nombre</h2>
                        <div class="flex gap-2">
                            <span class="px-4 py-1.5 bg-indigo-50 text-indigo-600 rounded-full text-xs font-black uppercase tracking-widest border border-indigo-100">@mascota.Raza</span>
                            <button @onclick="AbrirModalEditarMascota" class="w-10 h-10 bg-slate-100 text-slate-400 rounded-xl hover:bg-indigo-600 hover:text-white transition-all flex items-center justify-center" title="Editar datos del paciente">
                                <i class="fas fa-edit"></i>
                            </button>
                        </div>
                    </div>
                    
                    <div class="grid grid-cols-2 md:grid-cols-5 gap-4">
                        <div class="bg-slate-50/50 p-4 rounded-3xl border border-slate-100/50">
                            <p class="text-[0.6rem] font-black text-slate-400 uppercase tracking-widest mb-1">Especie</p>
                            <p class="font-bold text-slate-700">@mascota.Especie</p>
                        </div>
                        <div class="bg-slate-50/50 p-4 rounded-3xl border border-slate-100/50">
                            <p class="text-[0.6rem] font-black text-slate-400 uppercase tracking-widest mb-1">Edad</p>
                            <p class="font-bold text-slate-700">@mascota.Edad años</p>
                        </div>
                        <div class="bg-slate-50/50 p-4 rounded-3xl border border-slate-100/50">
                            <p class="text-[0.6rem] font-black text-slate-400 uppercase tracking-widest mb-1">Sexo</p>
                            <p class="font-bold text-slate-700">@mascota.Sexo</p>
                        </div>
                        <div class="bg-slate-50/50 p-4 rounded-3xl border border-slate-100/50">
                            <p class="text-[0.6rem] font-black text-slate-400 uppercase tracking-widest mb-1">Peso</p>
                            <p class="font-bold text-indigo-600">@mascota.Peso kg</p>
                        </div>
                        <div class="bg-slate-50/50 p-4 rounded-3xl border border-slate-100/50">
                            <p class="text-[0.6rem] font-black text-slate-400 uppercase tracking-widest mb-1">Color</p>
                            <p class="font-bold text-slate-700">@(string.IsNullOrEmpty(mascota.Color) ? "N/A" : mascota.Color)</p>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="grid grid-cols-1 lg:grid-cols-3 gap-10">
            <!-- Línea de Tiempo de Eventos -->
            <div class="lg:col-span-2">
                <div class="flex items-center gap-3 mb-8">
                    <div class="h-1 w-12 bg-indigo-600 rounded-full"></div>
                    <h3 class="text-xl font-black text-slate-800 uppercase tracking-tight">Actividad Médica Reciente</h3>
                </div>

                @if (!eventos.Any())
                {
                    <div class="bg-white rounded-[2.5rem] p-20 text-center border-2 border-dashed border-slate-100">
                        <div class="w-24 h-24 bg-slate-50 rounded-full flex items-center justify-center mx-auto mb-6 text-slate-200 text-4xl">
                            <i class="fas fa-folder-open"></i>
                        </div>
                        <h4 class="text-xl font-bold text-slate-400 mb-2">Sin registros médicos</h4>
                        <p class="text-slate-300 text-sm">No se han encontrado eventos para @mascota.Nombre. Comienza agregando uno nuevo.</p>
                    </div>
                }
                else
                {
                    <div class="relative pl-10 space-y-10">
                        <div class="absolute left-4 top-0 bottom-0 w-1 bg-gradient-to-b from-indigo-500/20 via-purple-500/20 to-transparent rounded-full"></div>
                        
                        @foreach (var item in eventos)
                        {
                            <div class="relative group">
                                <div class="absolute -left-10 top-0 w-10 h-10 @item.ColorClase rounded-2xl shadow-lg flex items-center justify-center text-white text-sm z-10 transition-transform group-hover:scale-110">
                                    <i class="fas @item.Icono"></i>
                                </div>
                                
                                <div class="bg-white p-8 rounded-[2rem] shadow-xl shadow-slate-100 border border-slate-50 hover:border-indigo-100 transition-all">
                                    <div class="flex justify-between items-start mb-4">
                                        <div class="space-y-1">
                                            <span class="text-[0.65rem] font-black text-indigo-400 uppercase tracking-widest">@item.TipoEvento • @item.Fecha.ToString("dd MMM, yyyy")</span>
                                            <div class="flex items-center gap-3">
                                                <h4 class="text-xl font-black text-slate-800">@item.Titulo</h4>
                                                @if (item.Costo > 0)
                                                {
                                                    <span class="bg-emerald-50 text-emerald-600 px-3 py-1 rounded-full text-xs font-black border border-emerald-100">
                                                        $@item.Costo.ToString("0.00")
                                                    </span>
                                                }
                                            </div>
                                        </div>
                                        <div class="flex gap-2">
                                            <button @onclick="() => AbrirModalEditar(item)" class="text-[0.65rem] font-black bg-amber-50 text-amber-600 px-4 py-2 rounded-xl hover:bg-amber-500 hover:text-white transition-all flex items-center">
                                                <i class="fas fa-edit mr-2"></i> EDITAR
                                            </button>
                                            <button @onclick="() => EliminarEvento(item)" class="text-[0.65rem] font-black bg-rose-50 text-rose-500 px-4 py-2 rounded-xl hover:bg-rose-500 hover:text-white transition-all flex items-center">
                                                <i class="fas fa-trash mr-2"></i>
                                            </button>
                                            <button @onclick="() => ImprimirReceta(item)" class="text-[0.65rem] font-black bg-slate-50 text-slate-500 px-4 py-2 rounded-xl hover:bg-indigo-600 hover:text-white transition-all flex items-center">
                                                <i class="fas fa-print mr-2"></i> RECETA
                                            </button>
                                        </div>
                                    </div>
                                    
                                    <p class="text-slate-500 leading-relaxed mb-6 italic">"@item.Descripcion"</p>
                                    
                                    <div class="pt-6 border-t border-slate-50 flex items-center justify-between">
                                        <div class="flex items-center gap-2">
                                            <div class="w-8 h-8 bg-slate-100 rounded-full flex items-center justify-center text-slate-400 text-xs">
                                                <i class="fas fa-user-md"></i>
                                            </div>
                                            <span class="text-xs font-bold text-slate-400 uppercase tracking-widest">Atendido por Dr. @item.MedicoResponsable</span>
                                        </div>
                                        
                                        @if (!string.IsNullOrEmpty(item.DetallesExtras))
                                        {
                                            <span class="text-[0.6rem] bg-indigo-50 text-indigo-400 px-3 py-1 rounded-lg font-black uppercase">@item.DetallesExtras</span>
                                        }
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                }
            </div>

            <!-- Resumen de Salud -->
            <div class="space-y-8">
                <div class="bg-white p-8 rounded-[2.5rem] shadow-2xl shadow-slate-200/50 border border-slate-50">
                    <h3 class="text-lg font-black text-slate-800 mb-6 uppercase tracking-widest">Resumen de Salud</h3>
                    <div class="space-y-4">
                        <div class="flex items-center justify-between p-4 bg-emerald-50 rounded-3xl border border-emerald-100/50">
                            <div class="flex items-center gap-3">
                                <div class="w-10 h-10 bg-emerald-500 rounded-2xl flex items-center justify-center text-white text-xs">
                                    <i class="fas fa-shield-alt"></i>
                                </div>
                                <span class="font-bold text-emerald-800">Vacunas</span>
                            </div>
                            @{ var totalVacunas = eventos.Count(e => e.TipoEvento == "Vacuna"); }
                            @if (totalVacunas == 0)
                            {
                                <span class="text-sm font-bold text-emerald-400 italic">Ninguna</span>
                            }
                            else
                            {
                                <span class="text-2xl font-black text-emerald-600">@totalVacunas</span>
                            }
                        </div>

                        <div class="flex items-center justify-between p-4 bg-amber-50 rounded-3xl border border-amber-100/50">
                            <div class="flex items-center gap-3">
                                <div class="w-10 h-10 bg-amber-500 rounded-2xl flex items-center justify-center text-white text-xs">
                                    <i class="fas fa-bug"></i>
                                </div>
                                <span class="font-bold text-amber-800">Desparasitaciones</span>
                            </div>
                            @{ var totalDesparasitaciones = eventos.Count(e => e.TipoEvento == "Desparasitacion"); }
                            @if (totalDesparasitaciones == 0)
                            {
                                <span class="text-sm font-bold text-amber-400 italic">Ninguna</span>
                            }
                            else
                            {
                                <span class="text-2xl font-black text-amber-600">@totalDesparasitaciones</span>
                            }
                        </div>
                        
                        <div class="flex items-center justify-between p-4 bg-rose-50 rounded-3xl border border-rose-100/50">
                            <div class="flex items-center gap-3">
                                <div class="w-10 h-10 bg-rose-500 rounded-2xl flex items-center justify-center text-white text-xs">
                                    <i class="fas fa-heartbeat"></i>
                                </div>
                                <span class="font-bold text-rose-800">Cirugías</span>
                            </div>
                            @{ var totalCirugias = eventos.Count(e => e.TipoEvento == "Cirugia"); }
                            @if (totalCirugias == 0)
                            {
                                <span class="text-sm font-bold text-rose-400 italic">Ninguna</span>
                            }
                            else
                            {
                                <span class="text-2xl font-black text-rose-600">@totalCirugias</span>
                            }
                        </div>
                    </div>
                </div>

                <div class="bg-indigo-600 p-8 rounded-[2.5rem] shadow-2xl shadow-indigo-200 text-white relative overflow-hidden">
                    <div class="absolute -right-4 -bottom-4 opacity-10 text-9xl">
                        <i class="fas fa-stethoscope"></i>
                    </div>
                    <h3 class="text-lg font-black mb-4 uppercase tracking-widest opacity-80">Reporte Médico</h3>
                    <p class="text-sm leading-relaxed mb-6 opacity-90">Visualiza el historial completo de @mascota.Nombre en un formato listo para imprimir.</p>
                    <button @onclick="Imprimir" class="w-full bg-white text-indigo-600 py-4 rounded-2xl font-black shadow-xl hover:bg-indigo-50 transition-all flex items-center justify-center">
                        <i class="fas fa-print mr-2"></i> GENERAR REPORTE
                    </button>
                </div>
            </div>
        </div>
    }
</div>

<!-- Modal para Nuevo Registro -->
@if (mostrarModal)
{
    <div class="fixed inset-0 bg-slate-900/60 backdrop-blur-sm flex items-center justify-center z-50 p-4 no-print">
        <div class="bg-white w-full max-w-2xl rounded-[2.5rem] shadow-2xl overflow-hidden animate-zoom-in">
            <div class="bg-indigo-600 p-8 text-white flex justify-between items-center">
                <div>
                    <h3 class="text-2xl font-black tracking-tighter">@(eventoEditandoId.HasValue ? "Editar Registro" : "Nuevo Registro")</h3>
                    <p class="text-indigo-100 text-xs font-bold uppercase tracking-widest">@(eventoEditandoId.HasValue ? "Modificando evento de" : "Añadiendo evento para") @mascota?.Nombre</p>
                </div>
                <button @onclick="CerrarModal" class="w-10 h-10 bg-white/10 rounded-full flex items-center justify-center hover:bg-white/20 transition-colors">
                    <i class="fas fa-times"></i>
                </button>
            </div>
            
            <EditForm Model="nuevoEvento" OnValidSubmit="GuardarEvento">
                <div class="p-10 space-y-6">
                    <div>
                        <label class="block text-[0.65rem] font-black text-slate-400 uppercase tracking-widest mb-2">Motivo de Consulta / Título</label>
                        <InputText @bind-Value="nuevoEvento.Titulo" class="w-full px-4 py-3 bg-slate-50 border border-slate-100 rounded-xl text-sm focus:bg-white focus:ring-2 focus:ring-indigo-500 transition-all" placeholder="Ej: Desparasitación, Vitamina, Chequeo..." required />
                    </div>

                    <div class="grid grid-cols-2 gap-6">
                        <div>
                            <label class="block text-[0.65rem] font-black text-slate-400 uppercase tracking-widest mb-2">Tipo de Evento</label>
                            <InputSelect @bind-Value="nuevoEvento.Tipo" class="w-full px-4 py-3 bg-slate-50 border border-slate-100 rounded-xl text-sm focus:bg-white focus:ring-2 focus:ring-indigo-500 transition-all">
                                <option value="@TipoEventoMedico.Consulta">🩺 Consulta General</option>
                                <option value="@TipoEventoMedico.Vacuna">💉 Vacunación</option>
                                <option value="@TipoEventoMedico.Desparasitacion">🪱 Desparasitación</option>
                                <option value="@TipoEventoMedico.Cirugia">🔬 Cirugía</option>
                                <option value="@TipoEventoMedico.ExamenLaboratorio">🧪 Laboratorio</option>
                                <option value="@TipoEventoMedico.Grooming">✂️ Grooming (Peluquería)</option>
                            </InputSelect>
                        </div>
                        <div>
                            <label class="block text-[0.65rem] font-black text-slate-400 uppercase tracking-widest mb-2">Costo del Servicio / Productos</label>
                            <div class="relative">
                                <span class="absolute left-4 top-1/2 -translate-y-1/2 text-slate-400 font-bold">$</span>
                                <InputNumber @bind-Value="nuevoEvento.Costo" class="w-full pl-8 pr-4 py-3 bg-slate-50 border border-slate-100 rounded-xl text-sm focus:bg-white focus:ring-2 focus:ring-indigo-500 transition-all" placeholder="0.00" />
                            </div>
                        </div>
                    </div>

                    <div class="grid grid-cols-2 gap-6">
                        <div>
                            <label class="block text-[0.65rem] font-black text-slate-400 uppercase tracking-widest mb-2">Fecha</label>
                            <InputDate @bind-Value="nuevoEvento.Fecha" class="w-full px-4 py-3 bg-slate-50 border border-slate-100 rounded-xl text-sm focus:bg-white focus:ring-2 focus:ring-indigo-500 transition-all" />
                        </div>
                        <div>
                            <label class="block text-[0.65rem] font-black text-slate-400 uppercase tracking-widest mb-2">Médico Responsable</label>
                            <div class="relative">
                                <span class="absolute left-4 top-1/2 -translate-y-1/2 text-indigo-500"><i class="fas fa-user-md"></i></span>
                                <select @bind="nuevoEvento.MedicoResponsable" class="w-full pl-11 pr-4 py-3 bg-slate-50 border border-slate-100 rounded-xl text-sm focus:bg-white focus:ring-2 focus:ring-indigo-500 outline-none transition-all appearance-none" required>
                                    <option value="">Seleccione un médico...</option>
                                    @foreach (var doc in AppState.Trabajadores)
                                    {
                                        <option value="@doc.Nombres">@doc.Nombres (@doc.Rol)</option>
                                    }
                                </select>
                            </div>
                        </div>
                    </div>

                    <div>
                        <label class="block text-[0.65rem] font-black text-slate-400 uppercase tracking-widest mb-2">Descripción / Diagnóstico</label>
                        <InputTextArea @bind-Value="nuevoEvento.Descripcion" rows="3" class="w-full px-4 py-3 bg-slate-50 border border-slate-100 rounded-xl text-sm focus:bg-white focus:ring-2 focus:ring-indigo-500 transition-all" placeholder="Escriba los detalles médicos aquí..." />
                    </div>

                    @* Campos adicionales según el tipo de evento *@
                    @if (nuevoEvento.Tipo == TipoEventoMedico.Vacuna)
                    {
                        <div class="bg-emerald-50 p-5 rounded-2xl border border-emerald-100 space-y-4">
                            <p class="text-[0.65rem] font-black text-emerald-600 uppercase tracking-widest">💉 Detalles de Vacunación</p>
                            <div class="grid grid-cols-2 gap-4">
                                <div>
                                    <label class="block text-[0.65rem] font-black text-slate-400 uppercase tracking-widest mb-2">Vacuna / Producto Aplicado</label>
                                    <InputText @bind-Value="nuevoEvento.InfoExtra1" class="w-full px-4 py-3 bg-white border border-emerald-200 rounded-xl text-sm focus:ring-2 focus:ring-emerald-500 transition-all" placeholder="Ej: Parvovirus, Rabia, Sextuple..." />
                                </div>
                                <div>
                                    <label class="block text-[0.65rem] font-black text-slate-400 uppercase tracking-widest mb-2">Fecha Próxima Dosis</label>
                                    <InputDate @bind-Value="nuevoEvento.ProximaDosis" class="w-full px-4 py-3 bg-white border border-emerald-200 rounded-xl text-sm focus:ring-2 focus:ring-emerald-500 transition-all" />
                                </div>
                            </div>
                        </div>
                    }

                    @if (nuevoEvento.Tipo == TipoEventoMedico.Desparasitacion)
                    {
                        <div class="bg-amber-50 p-5 rounded-2xl border border-amber-100 space-y-4">
                            <p class="text-[0.65rem] font-black text-amber-600 uppercase tracking-widest">🪱 Detalles de Desparasitación</p>
                            <div class="grid grid-cols-2 gap-4">
                                <div>
                                    <label class="block text-[0.65rem] font-black text-slate-400 uppercase tracking-widest mb-2">Producto Desparasitante</label>
                                    <InputText @bind-Value="nuevoEvento.InfoExtra1" class="w-full px-4 py-3 bg-white border border-amber-200 rounded-xl text-sm focus:ring-2 focus:ring-amber-500 transition-all" placeholder="Ej: Drontal, Milbemax, Ivermectina..." />
                                </div>
                                <div>
                                    <label class="block text-[0.65rem] font-black text-slate-400 uppercase tracking-widest mb-2">Próxima Desparasitación</label>
                                    <InputDate @bind-Value="nuevoEvento.ProximaDosis" class="w-full px-4 py-3 bg-white border border-amber-200 rounded-xl text-sm focus:ring-2 focus:ring-amber-500 transition-all" />
                                </div>
                            </div>
                        </div>
                    }

                    @if (nuevoEvento.Tipo == TipoEventoMedico.Cirugia)
                    {
                        <div class="bg-rose-50 p-5 rounded-2xl border border-rose-100 space-y-4">
                            <p class="text-[0.65rem] font-black text-rose-600 uppercase tracking-widest">🔬 Detalles de Cirugía</p>
                            <div class="grid grid-cols-2 gap-4">
                                <div>
                                    <label class="block text-[0.65rem] font-black text-slate-400 uppercase tracking-widest mb-2">Tipo de Anestesia</label>
                                    <InputText @bind-Value="nuevoEvento.InfoExtra1" class="w-full px-4 py-3 bg-white border border-rose-200 rounded-xl text-sm focus:ring-2 focus:ring-rose-500 transition-all" placeholder="Ej: General, Local, Epidural..." />
                                </div>
                                <div>
                                    <label class="block text-[0.65rem] font-black text-slate-400 uppercase tracking-widest mb-2">Reporte Post-Operatorio</label>
                                    <InputText @bind-Value="nuevoEvento.InfoExtra2" class="w-full px-4 py-3 bg-white border border-rose-200 rounded-xl text-sm focus:ring-2 focus:ring-rose-500 transition-all" placeholder="Ej: Recuperación satisfactoria..." />
                                </div>
                            </div>
                        </div>
                    }
                </div>

                <div class="p-8 bg-slate-50 flex flex-col border-t border-slate-100">
                    @if (!string.IsNullOrEmpty(errorModal))
                    {
                        <div class="mb-4 p-3 bg-red-100 text-red-700 text-xs font-bold rounded-xl animate-shake">
                            <i class="fas fa-exclamation-triangle mr-2"></i> @errorModal
                        </div>
                    }
                    <div class="flex justify-end gap-4">
                        <button type="button" @onclick="CerrarModal" class="px-6 py-2.5 font-bold text-slate-400 hover:text-slate-600 transition-colors">CANCELAR</button>
                        <button type="submit" disabled="@isSaving" class="px-10 py-3 @(isSaving ? "bg-slate-400" : "bg-indigo-600") text-white rounded-2xl font-black shadow-xl shadow-indigo-100 hover:bg-indigo-700 transition-all transform hover:-translate-y-1 flex items-center">
                            @if (isSaving)
                            {
                                <i class="fas fa-spinner fa-spin mr-2"></i> <span>GUARDANDO...</span>
                            }
                            else
                            {
                                <span>GUARDAR REGISTRO</span>
                            }
                        </button>
                    </div>
                </div>
            </EditForm>
        </div>
    </div>
}

@if (mostrarModalEditarMascota && mascota != null)
{
    <div class="fixed inset-0 bg-slate-900/60 backdrop-blur-sm flex items-center justify-center z-50 p-4 no-print">
        <div class="bg-white w-full max-w-xl rounded-[2.5rem] shadow-2xl overflow-hidden animate-zoom-in">
            <div class="bg-amber-500 p-8 text-white flex justify-between items-center">
                <div>
                    <h3 class="text-2xl font-black tracking-tighter">Editar Paciente</h3>
                    <p class="text-amber-100 text-xs font-bold uppercase tracking-widest">Modificando ficha de @mascota.Nombre</p>
                </div>
                <button @onclick="() => mostrarModalEditarMascota = false" class="w-10 h-10 bg-white/10 rounded-full flex items-center justify-center hover:bg-white/20 transition-colors">
                    <i class="fas fa-times"></i>
                </button>
            </div>
            
            <div class="p-10 space-y-6">
                <div class="grid grid-cols-2 gap-6">
                    <div>
                        <label class="block text-[0.65rem] font-black text-slate-400 uppercase tracking-widest mb-2">Nombre</label>
                        <input type="text" @bind="mascota.Nombre" class="w-full px-4 py-3 bg-slate-50 border border-slate-100 rounded-xl text-sm focus:bg-white focus:ring-2 focus:ring-amber-500 transition-all" />
                    </div>
                    <div>
                        <label class="block text-[0.65rem] font-black text-slate-400 uppercase tracking-widest mb-2">Raza</label>
                        <input type="text" @bind="mascota.Raza" class="w-full px-4 py-3 bg-slate-50 border border-slate-100 rounded-xl text-sm focus:bg-white focus:ring-2 focus:ring-amber-500 transition-all" />
                    </div>
                </div>

                <div class="grid grid-cols-3 gap-6">
                    <div>
                        <label class="block text-[0.65rem] font-black text-slate-400 uppercase tracking-widest mb-2">Edad</label>
                        <input type="number" @bind="mascota.Edad" class="w-full px-4 py-3 bg-slate-50 border border-slate-100 rounded-xl text-sm focus:bg-white focus:ring-2 focus:ring-amber-500 transition-all" />
                    </div>
                    <div>
                        <label class="block text-[0.65rem] font-black text-slate-400 uppercase tracking-widest mb-2">Peso (kg)</label>
                        <input type="number" @bind="mascota.Peso" step="0.01" class="w-full px-4 py-3 bg-slate-50 border border-slate-100 rounded-xl text-sm focus:bg-white focus:ring-2 focus:ring-amber-500 transition-all" />
                    </div>
                    <div>
                        <label class="block text-[0.65rem] font-black text-slate-400 uppercase tracking-widest mb-2">Sexo</label>
                        <select @bind="mascota.Sexo" class="w-full px-4 py-3 bg-slate-50 border border-slate-100 rounded-xl text-sm focus:bg-white focus:ring-2 focus:ring-amber-500 transition-all">
                            <option value="Macho">Macho</option>
                            <option value="Hembra">Hembra</option>
                        </select>
                    </div>
                </div>

                <div>
                    <label class="block text-[0.65rem] font-black text-slate-400 uppercase tracking-widest mb-2">Color</label>
                    <input type="text" @bind="mascota.Color" class="w-full px-4 py-3 bg-slate-50 border border-slate-100 rounded-xl text-sm focus:bg-white focus:ring-2 focus:ring-amber-500 transition-all" placeholder="Ej: Blanco con manchas negras..." />
                </div>
            </div>

            <div class="p-8 bg-slate-50 flex justify-end gap-4 border-t border-slate-100">
                <button @onclick="() => mostrarModalEditarMascota = false" class="px-6 py-2.5 font-bold text-slate-400 hover:text-slate-600 transition-colors">CANCELAR</button>
                <button @onclick="GuardarCambiosMascota" disabled="@isSaving" class="px-10 py-3 bg-amber-500 text-white rounded-2xl font-black shadow-xl shadow-amber-100 hover:bg-amber-600 transition-all transform hover:-translate-y-1">
                    @if (isSaving)
                    {
                        <i class="fas fa-spinner fa-spin mr-2"></i> <span>GUARDANDO...</span>
                    }
                    else
                    {
                        <span>ACTUALIZAR FICHA</span>
                    }
                </button>
            </div>
        </div>
    </div>
}

