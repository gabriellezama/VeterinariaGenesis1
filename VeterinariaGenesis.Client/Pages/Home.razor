@page "/"
@implements IDisposable
@using System
@using System.Linq
@using System.Threading.Tasks
@using VeterinariaGenesis.Domain.Entities
@using VeterinariaGenesis.Client.Services
@inject AppStateService AppState

<PageTitle>Dashboard | Veterinaria Génesis</PageTitle>

<div class="mb-6 flex justify-between items-end">
    <div>
        <h1 class="text-2xl font-bold text-gray-900">Bienvenido(a), @DoctorActual</h1>
        <p class="text-sm text-gray-500">Resumen general de la clínica al @DateTime.Now.ToShortDateString()</p>
    </div>
    
    <div class="w-64">
        <label for="doctor" class="block text-xs font-medium text-gray-500 mb-1">Doctor en Turno</label>
        <select id="doctor" @bind="DoctorActual" class="block w-full pl-3 pr-10 py-2 border border-gray-200 rounded-lg text-sm focus:outline-none focus:ring-1 focus:ring-indigo-500 focus:border-indigo-500 bg-white shadow-sm">
            @if (AppState.Trabajadores.Any())
            {
                @foreach (var trabajador in AppState.Trabajadores)
                {
                    <option value="@trabajador.Nombres">@trabajador.Nombres @trabajador.Apellidos</option>
                }
            }
            else
            {
                <option value="Sin Personal Registrado">Sin Personal Registrado</option>
            }
        </select>
    </div>
</div>

<!-- KPIs -->
<div class="grid grid-cols-1 md:grid-cols-3 gap-6 mb-8">
    <div class="bg-white rounded-xl shadow-sm p-6 border border-gray-100 flex items-center">
        <div class="w-14 h-14 rounded-full bg-blue-50 flex items-center justify-center text-blue-600 text-2xl mr-4">
            <i class="fas fa-paw"></i>
        </div>
        <div>
            <p class="text-sm font-medium text-gray-500">Total Pacientes</p>
            <p class="text-2xl font-bold text-gray-900">@AppState.Mascotas.Count()</p>
            <p class="text-xs text-green-500 font-medium"><i class="fas fa-check-circle"></i> Sistema Activo</p>
        </div>
    </div>
    
    <div class="bg-white rounded-xl shadow-sm p-6 border border-gray-100 flex items-center">
        <div class="w-14 h-14 rounded-full bg-indigo-50 flex items-center justify-center text-indigo-600 text-2xl mr-4">
            <i class="fas fa-user-plus"></i>
        </div>
        <div>
            <p class="text-sm font-medium text-gray-500">Clientes Registrados</p>
            <p class="text-2xl font-bold text-gray-900">@AppState.Clientes.Count()</p>
            <p class="text-xs text-indigo-500 font-medium"><i class="fas fa-users"></i> Directorio</p>
        </div>
    </div>
    
    <div class="bg-white rounded-xl shadow-sm p-6 border border-gray-100 flex items-center">
        <div class="w-14 h-14 rounded-full bg-emerald-50 flex items-center justify-center text-emerald-600 text-2xl mr-4">
            <i class="fas fa-dollar-sign"></i>
        </div>
        <div>
            <p class="text-sm font-medium text-gray-500">Ingresos Totales</p>
            <p class="text-2xl font-bold text-gray-900">$@AppState.Facturas.Sum(f => f.Total).ToString("N2")</p>
        </div>
    </div>
</div>

<!-- Últimas Actividades -->
<div class="bg-white rounded-xl shadow-sm border border-gray-100 overflow-hidden">
    <div class="px-6 py-4 border-b border-gray-100 flex justify-between items-center">
        <h3 class="text-lg font-bold text-gray-900">Últimas Mascotas Registradas</h3>
        <button @onclick='() => NavigationManager.NavigateTo("clientes")' class="text-indigo-600 text-sm font-medium hover:text-indigo-800">Ver todas</button>
    </div>
    <div class="overflow-x-auto">
        <table class="w-full text-left border-collapse">
            <thead>
                <tr class="bg-gray-50 text-gray-500 text-xs uppercase tracking-wider">
                    <th class="px-6 py-3 font-medium">Fecha Reg.</th>
                    <th class="px-6 py-3 font-medium">Mascota</th>
                    <th class="px-6 py-3 font-medium">Cliente</th>
                    <th class="px-6 py-3 font-medium">Especie</th>
                    <th class="px-6 py-3 font-medium">Estado</th>
                </tr>
            </thead>
            <tbody class="divide-y divide-gray-100 text-sm">
                @if (!AppState.Mascotas.Any())
                {
                    <tr>
                        <td colspan="5" class="px-6 py-8 text-center text-gray-400">No hay mascotas registradas aún.</td>
                    </tr>
                }
                else
                {
                    @foreach (var mascota in AppState.Mascotas.AsEnumerable().Reverse().Take(5))
                    {
                        var cliente = AppState.Clientes.FirstOrDefault(c => c.Id == mascota.ClienteId);
                        <tr class="hover:bg-gray-50 transition-colors">
                            <td class="px-6 py-4 font-medium text-gray-900">Hoy</td>
                            <td class="px-6 py-4"><i class="fas @(mascota.Especie?.ToLower() == "gato" ? "fa-cat" : "fa-dog") text-indigo-400 mr-2"></i> @mascota.Nombre</td>
                            <td class="px-6 py-4 text-gray-500">@(cliente?.Nombres ?? "Desconocido")</td>
                            <td class="px-6 py-4">@mascota.Especie</td>
                            <td class="px-6 py-4">
                                <span class="px-2 py-1 bg-green-100 text-green-800 rounded-full text-xs font-medium">Activo</span>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>

@code {
    private string DoctorActual { get; set; } = "Sin Personal Registrado";

    protected override async Task OnInitializedAsync()
    {
        AppState.OnChange += StateHasChanged;
        await AppState.LoadTrabajadoresAsync();
        await AppState.LoadClientesAsync();
        await AppState.LoadMascotasAsync();
        await AppState.LoadFacturasAsync();
        
        if (AppState.Trabajadores.Any())
        {
            DoctorActual = AppState.Trabajadores.First().Nombres;
        }
    }

    public void Dispose()
    {
        AppState.OnChange -= StateHasChanged;
    }
}
