@page "/"
@inject VeterinariaGenesis.Client.Services.AppStateService AppState
@inject NavigationManager Nav
@implements IDisposable

<PageTitle>Dashboard | Veterinaria Génesis</PageTitle>

<div class="page-transition">
    <!-- Header del Dashboard -->
    <div class="mb-8">
        <h1 class="text-3xl font-black text-slate-900 tracking-tight">Panel de Control</h1>
        <p class="text-slate-500">Bienvenido de vuelta, Administrador. Aquí tienes un resumen de hoy.</p>
    </div>

    <!-- Resumen de KPIs -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6 mb-8">
        <div class="bg-white p-6 rounded-2xl shadow-sm border border-slate-100 card-hover">
            <div class="flex items-center">
                <div class="p-3 bg-indigo-50 rounded-xl text-indigo-600 mr-4">
                    <i class="fas fa-paw text-2xl"></i>
                </div>
                <div>
                    <p class="text-sm text-slate-500 font-medium uppercase tracking-wider">Mascotas</p>
                    <h3 class="text-2xl font-bold text-slate-800">@AppState.Mascotas.Count</h3>
                </div>
            </div>
            <div class="mt-4 flex items-center text-xs text-green-600 font-bold bg-green-50 w-fit px-2 py-1 rounded-full">
                <i class="fas fa-arrow-up mr-1"></i> Sistema Activo
            </div>
        </div>

        <div class="bg-white p-6 rounded-2xl shadow-sm border border-slate-100 card-hover">
            <div class="flex items-center">
                <div class="p-3 bg-emerald-50 rounded-xl text-emerald-600 mr-4">
                    <i class="fas fa-users text-2xl"></i>
                </div>
                <div>
                    <p class="text-sm text-slate-500 font-medium uppercase tracking-wider">Clientes</p>
                    <h3 class="text-2xl font-bold text-slate-800">@AppState.Clientes.Count</h3>
                </div>
            </div>
            <div class="mt-4 flex items-center text-xs text-green-600 font-bold bg-green-50 w-fit px-2 py-1 rounded-full">
                <i class="fas fa-check mr-1"></i> Actualizado
            </div>
        </div>

        <div class="bg-white p-6 rounded-2xl shadow-sm border border-slate-100 card-hover">
            <div class="flex items-center">
                <div class="p-3 bg-amber-50 rounded-xl text-amber-600 mr-4">
                    <i class="fas fa-hand-holding-usd text-2xl"></i>
                </div>
                <div>
                    <p class="text-sm text-slate-500 font-medium uppercase tracking-wider">Ingresos Totales</p>
                    <h3 class="text-2xl font-bold text-slate-800">C$ @AppState.Facturas.Sum(f => f.Total).ToString("N2")</h3>
                </div>
            </div>
            <div class="mt-4 flex items-center text-xs text-amber-600 font-bold bg-amber-50 w-fit px-2 py-1 rounded-full">
                <i class="fas fa-coins mr-1"></i> Acumulado
            </div>
        </div>

        <div class="bg-white p-6 rounded-2xl shadow-sm border border-slate-100 card-hover">
            <div class="flex items-center">
                <div class="p-3 bg-rose-50 rounded-xl text-rose-600 mr-4">
                    <i class="fas fa-calendar-check text-2xl"></i>
                </div>
                <div>
                    <p class="text-sm text-slate-500 font-medium uppercase tracking-wider">Citas Hoy</p>
                    <h3 class="text-2xl font-bold text-slate-800">8</h3>
                </div>
            </div>
            <div class="mt-4 flex items-center text-xs text-rose-600 font-bold bg-rose-50 w-fit px-2 py-1 rounded-full">
                <i class="fas fa-exclamation-circle mr-1"></i> 2 pendientes
            </div>
        </div>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
        <!-- Actividad Reciente -->
        <div class="lg:col-span-2 bg-white rounded-2xl shadow-sm border border-slate-100 overflow-hidden card-hover">
            <div class="p-6 border-b border-slate-50 flex justify-between items-center bg-slate-50/50">
                <h3 class="font-bold text-slate-800 text-lg flex items-center">
                    <i class="fas fa-history mr-2 text-indigo-500"></i> Últimas Facturas
                </h3>
                <button class="text-indigo-600 text-sm font-bold hover:underline">Ver todo</button>
            </div>
            <div class="overflow-x-auto">
                <table class="w-full text-left">
                    <thead class="bg-slate-50 text-slate-400 text-xs uppercase font-bold">
                        <tr>
                            <th class="px-6 py-4">ID Factura</th>
                            <th class="px-6 py-4">Fecha</th>
                            <th class="px-6 py-4">Total</th>
                            <th class="px-6 py-4">Estado</th>
                        </tr>
                    </thead>
                    <tbody class="text-sm divide-y divide-slate-50">
                        @if (!AppState.Facturas.Any())
                        {
                            <tr>
                                <td colspan="4" class="px-6 py-12 text-center text-slate-400 italic">No hay actividad reciente</td>
                            </tr>
                        }
                        else
                        {
                            @foreach (var fact in AppState.Facturas.OrderByDescending(f => f.Fecha).Take(5))
                            {
                                <tr class="hover:bg-slate-50/50 transition-colors">
                                    <td class="px-6 py-4">
                                        <div class="flex items-center">
                                            <div class="w-8 h-8 rounded-full bg-indigo-50 flex items-center justify-center text-indigo-600 mr-3">
                                                <i class="fas fa-file-invoice-dollar"></i>
                                            </div>
                                            <span class="font-bold text-slate-700">#@fact.Id.ToString().Substring(0, 5)</span>
                                        </div>
                                    </td>
                                    <td class="px-6 py-4 text-slate-500">@fact.Fecha.ToString("dd/MM/yyyy")</td>
                                    <td class="px-6 py-4 font-bold text-slate-900">C$ @fact.Total.ToString("N2")</td>
                                    <td class="px-6 py-4">
                                        <span class="px-3 py-1 bg-green-100 text-green-700 rounded-full text-xs font-bold">Pagado</span>
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>

        <!-- Atajos Rápidos -->
        <div class="bg-white rounded-2xl shadow-sm border border-slate-100 p-6 card-hover">
            <h3 class="font-bold text-slate-800 text-lg mb-6 flex items-center">
                <i class="fas fa-bolt mr-2 text-amber-500"></i> Acciones Rápidas
            </h3>
            <div class="space-y-4">
                <button @onclick='() => Nav.NavigateTo("facturacion/crear")' class="w-full flex items-center p-4 bg-indigo-600 hover:bg-indigo-700 text-white rounded-2xl transition-all shadow-lg shadow-indigo-100 transform hover:-translate-y-1 btn-pulse">
                    <i class="fas fa-plus-circle text-xl mr-3"></i>
                    <div class="text-left">
                        <p class="font-bold">Nueva Factura</p>
                        <p class="text-xs text-indigo-100">Registrar venta ahora</p>
                    </div>
                </button>
                <button @onclick='() => Nav.NavigateTo("clientes")' class="w-full flex items-center p-4 bg-white border border-slate-100 hover:border-emerald-100 hover:bg-emerald-50 text-slate-700 rounded-2xl transition-all transform hover:-translate-y-1 btn-pulse">
                    <i class="fas fa-user-plus text-xl mr-3 text-emerald-500"></i>
                    <div class="text-left">
                        <p class="font-bold text-slate-800">Clientes</p>
                        <p class="text-xs text-slate-500">Ver directorio completo</p>
                    </div>
                </button>
                <button @onclick='() => Nav.NavigateTo("proveedores")' class="w-full flex items-center p-4 bg-white border border-slate-100 hover:border-orange-100 hover:bg-orange-50 text-slate-700 rounded-2xl transition-all transform hover:-translate-y-1 btn-pulse">
                    <i class="fas fa-truck text-xl mr-3 text-orange-500"></i>
                    <div class="text-left">
                        <p class="font-bold text-slate-800">Proveedores</p>
                        <p class="text-xs text-slate-500">Gestionar suministros</p>
                    </div>
                </button>
            </div>
        </div>
    </div>
</div>

@code {
    protected override async Task OnInitializedAsync()
    {
        AppState.OnChange += StateHasChanged;
        // Cargar datos reales
        await AppState.LoadMascotasAsync();
        await AppState.LoadClientesAsync();
        await AppState.LoadFacturasAsync();
    }

    public void Dispose()
    {
        AppState.OnChange -= StateHasChanged;
    }
}
