@page "/"
@inject VeterinariaGenesis.Client.Services.AppStateService AppState
@inject NavigationManager Nav
@inject IJSRuntime JS
@implements IDisposable

<PageTitle>Dashboard | Veterinaria Génesis</PageTitle>

<div class="page-transition">

    <!-- Encabezado del Dashboard -->
    <div class="flex flex-col md:flex-row md:items-center md:justify-between mb-8 gap-4 select-none">
        <div>
            <h1 class="text-3xl font-black text-slate-900 dark:text-white tracking-tight">Panel de Control</h1>
            <p class="text-slate-500 dark:text-slate-400">Bienvenido al sistema de gestión — Veterinaria Génesis.</p>
        </div>
        <div class="text-right select-none">
            <p class="text-xs font-bold text-slate-400 uppercase tracking-widest">Fecha de hoy</p>
            <p class="text-sm font-black text-slate-700 dark:text-slate-300">@DateTime.Today.ToString("dddd, dd MMMM yyyy", System.Globalization.CultureInfo.CreateSpecificCulture("es-ES")).ToUpper()</p>
        </div>
    </div>

    <!-- ═══════════════════════════════════════════════════════
         TARJETAS RESUMEN KPI
    ═══════════════════════════════════════════════════════ -->
    <div class="grid grid-cols-2 lg:grid-cols-4 gap-4 mb-8 select-none">

        <!-- Ventas del Mes -->
        <div class="bg-white dark:bg-slate-900 border border-slate-100 dark:border-slate-800 p-5 rounded-[1.5rem] shadow-sm hover:shadow-md transition-shadow group">
            <div class="flex items-center justify-between mb-3">
                <span class="text-[10px] font-black uppercase tracking-widest text-slate-400">Ventas del Mes</span>
                <div class="w-9 h-9 bg-indigo-100 dark:bg-indigo-500/15 rounded-xl flex items-center justify-center group-hover:scale-110 transition-transform">
                    <i class="fas fa-coins text-indigo-600 dark:text-indigo-400 text-sm"></i>
                </div>
            </div>
            <p class="text-2xl font-black text-slate-900 dark:text-white">C$ @currentMonthSales.ToString("N0")</p>
            <p class="text-[10px] text-slate-400 mt-1">@totalFacturasMes facturas emitidas</p>
        </div>

        <!-- Gastos del Mes -->
        <div class="bg-white dark:bg-slate-900 border border-slate-100 dark:border-slate-800 p-5 rounded-[1.5rem] shadow-sm hover:shadow-md transition-shadow group">
            <div class="flex items-center justify-between mb-3">
                <span class="text-[10px] font-black uppercase tracking-widest text-slate-400">Gastos del Mes</span>
                <div class="w-9 h-9 bg-rose-100 dark:bg-rose-500/15 rounded-xl flex items-center justify-center group-hover:scale-110 transition-transform">
                    <i class="fas fa-arrow-trend-down text-rose-600 dark:text-rose-400 text-sm"></i>
                </div>
            </div>
            <p class="text-2xl font-black text-slate-900 dark:text-white">C$ @currentMonthExpenses.ToString("N0")</p>
            <p class="text-[10px] text-slate-400 mt-1">Egresos registrados</p>
        </div>

        <!-- Utilidad del Mes -->
        <div class="bg-white dark:bg-slate-900 border border-slate-100 dark:border-slate-800 p-5 rounded-[1.5rem] shadow-sm hover:shadow-md transition-shadow group">
            <div class="flex items-center justify-between mb-3">
                <span class="text-[10px] font-black uppercase tracking-widest text-slate-400">Utilidad Neta</span>
                <div class="w-9 h-9 @(currentMonthUtility >= 0 ? "bg-emerald-100 dark:bg-emerald-500/15" : "bg-rose-100 dark:bg-rose-500/15") rounded-xl flex items-center justify-center group-hover:scale-110 transition-transform">
                    <i class="fas fa-chart-line @(currentMonthUtility >= 0 ? "text-emerald-600 dark:text-emerald-400" : "text-rose-600 dark:text-rose-400") text-sm"></i>
                </div>
            </div>
            <p class="text-2xl font-black @(currentMonthUtility >= 0 ? "text-emerald-600 dark:text-emerald-400" : "text-rose-600 dark:text-rose-400")">C$ @currentMonthUtility.ToString("N0")</p>
            <p class="text-[10px] text-slate-400 mt-1">@(currentMonthUtility >= 0 ? "Saldo positivo ✅" : "Saldo negativo ⚠️")</p>
        </div>

        <!-- Total Mascotas -->
        <div class="bg-white dark:bg-slate-900 border border-slate-100 dark:border-slate-800 p-5 rounded-[1.5rem] shadow-sm hover:shadow-md transition-shadow group">
            <div class="flex items-center justify-between mb-3">
                <span class="text-[10px] font-black uppercase tracking-widest text-slate-400">Mascotas</span>
                <div class="w-9 h-9 bg-amber-100 dark:bg-amber-500/15 rounded-xl flex items-center justify-center group-hover:scale-110 transition-transform">
                    <i class="fas fa-paw text-amber-600 dark:text-amber-400 text-sm"></i>
                </div>
            </div>
            <p class="text-2xl font-black text-slate-900 dark:text-white">@AppState.Mascotas.Count</p>
            <p class="text-[10px] text-slate-400 mt-1">Registradas en el sistema</p>
        </div>
    </div>

    <!-- ═══════════════════════════════════════════════════════
         ACCESOS DIRECTOS AL SISTEMA
    ═══════════════════════════════════════════════════════ -->
    <div class="mb-8">
        <h2 class="text-xs font-black text-slate-400 uppercase tracking-widest mb-4 select-none">Acceso Rápido al Sistema</h2>
        <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-6 gap-4 select-none">

            <button @onclick='() => Nav.NavigateTo("estadisticas")'
                    class="flex flex-col items-center gap-3 p-5 bg-gradient-to-br from-indigo-600 to-purple-600 text-white rounded-[1.5rem] shadow-lg shadow-indigo-500/20 hover:shadow-xl hover:shadow-indigo-500/30 transition-all hover:-translate-y-1 active:scale-95 btn-pulse">
                <div class="w-12 h-12 bg-white/20 rounded-2xl flex items-center justify-center">
                    <i class="fas fa-chart-bar text-xl"></i>
                </div>
                <span class="text-xs font-black text-center leading-tight">Estadísticas</span>
            </button>

            <button @onclick='() => Nav.NavigateTo("facturacion/crear")'
                    class="flex flex-col items-center gap-3 p-5 bg-white dark:bg-slate-900 border border-slate-100 dark:border-slate-800 text-slate-700 dark:text-slate-300 rounded-[1.5rem] shadow-sm hover:shadow-md hover:border-indigo-200 dark:hover:border-indigo-800 transition-all hover:-translate-y-1 active:scale-95 btn-pulse group">
                <div class="w-12 h-12 bg-indigo-50 dark:bg-indigo-500/10 rounded-2xl flex items-center justify-center group-hover:scale-110 transition-transform">
                    <i class="fas fa-file-invoice-dollar text-xl text-indigo-600 dark:text-indigo-400"></i>
                </div>
                <span class="text-xs font-black text-center leading-tight">Nueva Venta</span>
            </button>

            <button @onclick='() => Nav.NavigateTo("clientes")'
                    class="flex flex-col items-center gap-3 p-5 bg-white dark:bg-slate-900 border border-slate-100 dark:border-slate-800 text-slate-700 dark:text-slate-300 rounded-[1.5rem] shadow-sm hover:shadow-md hover:border-teal-200 dark:hover:border-teal-800 transition-all hover:-translate-y-1 active:scale-95 btn-pulse group">
                <div class="w-12 h-12 bg-teal-50 dark:bg-teal-500/10 rounded-2xl flex items-center justify-center group-hover:scale-110 transition-transform">
                    <i class="fas fa-users text-xl text-teal-600 dark:text-teal-400"></i>
                </div>
                <span class="text-xs font-black text-center leading-tight">Clientes</span>
            </button>

            <button @onclick='() => Nav.NavigateTo("citas")'
                    class="flex flex-col items-center gap-3 p-5 bg-white dark:bg-slate-900 border border-slate-100 dark:border-slate-800 text-slate-700 dark:text-slate-300 rounded-[1.5rem] shadow-sm hover:shadow-md hover:border-amber-200 dark:hover:border-amber-800 transition-all hover:-translate-y-1 active:scale-95 btn-pulse group">
                <div class="w-12 h-12 bg-amber-50 dark:bg-amber-500/10 rounded-2xl flex items-center justify-center group-hover:scale-110 transition-transform">
                    <i class="fas fa-calendar-alt text-xl text-amber-600 dark:text-amber-400"></i>
                </div>
                <span class="text-xs font-black text-center leading-tight">Citas</span>
            </button>

            <button @onclick='() => Nav.NavigateTo("productos")'
                    class="flex flex-col items-center gap-3 p-5 bg-white dark:bg-slate-900 border border-slate-100 dark:border-slate-800 text-slate-700 dark:text-slate-300 rounded-[1.5rem] shadow-sm hover:shadow-md hover:border-purple-200 dark:hover:border-purple-800 transition-all hover:-translate-y-1 active:scale-95 btn-pulse group">
                <div class="w-12 h-12 bg-purple-50 dark:bg-purple-500/10 rounded-2xl flex items-center justify-center group-hover:scale-110 transition-transform">
                    <i class="fas fa-boxes text-xl text-purple-600 dark:text-purple-400"></i>
                </div>
                <span class="text-xs font-black text-center leading-tight">Inventario</span>
            </button>

            <button @onclick='() => Nav.NavigateTo("contabilidad")'
                    class="flex flex-col items-center gap-3 p-5 bg-white dark:bg-slate-900 border border-slate-100 dark:border-slate-800 text-slate-700 dark:text-slate-300 rounded-[1.5rem] shadow-sm hover:shadow-md hover:border-emerald-200 dark:hover:border-emerald-800 transition-all hover:-translate-y-1 active:scale-95 btn-pulse group">
                <div class="w-12 h-12 bg-emerald-50 dark:bg-emerald-500/10 rounded-2xl flex items-center justify-center group-hover:scale-110 transition-transform">
                    <i class="fas fa-calculator text-xl text-emerald-600 dark:text-emerald-400"></i>
                </div>
                <span class="text-xs font-black text-center leading-tight">Contabilidad</span>
            </button>

        </div>
    </div>

    <!-- ═══════════════════════════════════════════════════════
         MINI BANNER → IR A ESTADÍSTICAS
    ═══════════════════════════════════════════════════════ -->
    <div class="bg-gradient-to-r from-indigo-600 via-purple-600 to-indigo-700 rounded-[2rem] p-6 sm:p-8 flex flex-col sm:flex-row items-center justify-between gap-4 mb-8 shadow-xl shadow-indigo-500/20 select-none relative overflow-hidden">
        <div class="absolute -right-10 -top-10 w-40 h-40 bg-white/10 rounded-full blur-2xl pointer-events-none"></div>
        <div class="absolute -left-10 -bottom-10 w-40 h-40 bg-white/5 rounded-full blur-2xl pointer-events-none"></div>
        <div class="z-10 text-white">
            <p class="text-xs font-black uppercase tracking-widest text-white/70 mb-1">Análisis Comercial</p>
            <h2 class="text-xl sm:text-2xl font-black">📊 Ver Estadísticas y Reportes</h2>
            <p class="text-sm text-white/80 mt-1 max-w-md">Accede a los gráficos de ventas, distribución de servicios y diagnóstico de rendimiento mensual.</p>
        </div>
        <button @onclick='() => Nav.NavigateTo("estadisticas")'
                class="z-10 shrink-0 px-6 py-3 bg-white text-indigo-700 font-black rounded-2xl shadow-lg hover:shadow-xl hover:scale-105 active:scale-95 transition-all btn-pulse text-sm">
            Ir a Estadísticas →
        </button>
    </div>

    <!-- ═══════════════════════════════════════════════════════
         PANEL DE RECORDATORIOS INTELIGENTES
    ═══════════════════════════════════════════════════════ -->
    <div class="mb-8 bg-gradient-to-br from-emerald-50 to-teal-50 border border-emerald-100 dark:bg-emerald-950/20 dark:border-emerald-900/30 rounded-[2rem] p-6 shadow-sm select-none relative overflow-hidden">
        <div class="absolute -right-10 -top-10 w-40 h-40 bg-emerald-200/40 rounded-full blur-3xl pointer-events-none"></div>
        
        <div class="flex items-center justify-between mb-6 relative z-10">
            <div>
                <h3 class="font-black text-emerald-800 dark:text-emerald-400 text-lg flex items-center gap-2">
                    <i class="fab fa-whatsapp text-xl"></i> Recordatorios de Mañana
                </h3>
                <p class="text-xs text-emerald-600/80 dark:text-emerald-500 font-bold mt-1">Citas agendadas para el día de mañana pendientes de confirmación.</p>
            </div>
            <div class="bg-emerald-100 dark:bg-emerald-900/50 text-emerald-700 dark:text-emerald-300 px-4 py-2 rounded-xl text-xs font-black shadow-sm">
                @recordatoriosManana.Count Pendientes
            </div>
        </div>

        @if (!recordatoriosManana.Any())
        {
            <div class="text-center py-8 bg-white/50 dark:bg-slate-900/50 rounded-2xl border border-emerald-100/50">
                <div class="w-16 h-16 bg-emerald-100 dark:bg-emerald-900/30 rounded-full flex items-center justify-center text-emerald-500 mx-auto mb-4">
                    <i class="fas fa-check text-2xl"></i>
                </div>
                <p class="text-slate-600 font-bold">¡Todo al día!</p>
                <p class="text-xs text-slate-400 mt-1">No hay recordatorios pendientes para mañana.</p>
            </div>
        }
        else
        {
            <div class="grid grid-cols-1 md:grid-cols-2 xl:grid-cols-3 gap-4 relative z-10">
                @foreach (var cita in recordatoriosManana)
                {
                    var cliente = AppState.Clientes.FirstOrDefault(c => c.Id == cita.ClienteId);
                    var mascota = AppState.Mascotas.FirstOrDefault(m => m.Id == cita.MascotaId);
                    var nombreCliente = cliente != null ? $"{cliente.Nombres} {cliente.Apellidos}".Trim() : "Cliente";
                    if (string.IsNullOrEmpty(nombreCliente)) nombreCliente = cliente?.DisplayNombres ?? "Cliente";
                    
                    <div class="bg-white dark:bg-slate-900 p-5 rounded-2xl border border-emerald-100 dark:border-emerald-800/50 shadow-sm hover:shadow-md transition-all group">
                        <div class="flex justify-between items-start mb-3">
                            <div class="flex items-center gap-3">
                                <div class="w-10 h-10 bg-slate-50 dark:bg-slate-800 rounded-full flex items-center justify-center overflow-hidden border border-slate-100">
                                    @if (mascota != null && !string.IsNullOrEmpty(mascota.FotoBase64))
                                    {
                                        <img src="@mascota.FotoBase64" class="w-full h-full object-cover" />
                                    }
                                    else
                                    {
                                        <i class="fas fa-paw text-slate-300 text-sm"></i>
                                    }
                                </div>
                                <div>
                                    <p class="font-black text-slate-800 text-sm">@(mascota?.Nombre ?? "Mascota")</p>
                                    <p class="text-[0.65rem] font-bold text-slate-400">Dueño: @nombreCliente</p>
                                </div>
                            </div>
                            <div class="text-right">
                                <p class="text-xs font-black text-emerald-600">@cita.FechaHora.ToString("hh:mm tt")</p>
                            </div>
                        </div>
                        
                        <div class="bg-slate-50 p-3 rounded-xl border border-slate-100 mb-4">
                            <p class="text-[0.65rem] font-black uppercase tracking-widest text-slate-400 mb-1">Motivo / Tratamiento</p>
                            <p class="text-xs font-bold text-slate-700 truncate" title="@cita.Motivo">@cita.Motivo</p>
                        </div>

                        <button @onclick="() => EnviarNotificacionRapida(cita)" class="w-full py-2.5 bg-emerald-500 hover:bg-emerald-600 text-white rounded-xl text-xs font-black transition-all flex items-center justify-center gap-2 shadow-sm shadow-emerald-500/20 active:scale-95 group-hover:shadow-emerald-500/40">
                            <i class="fab fa-whatsapp text-sm"></i> Notificar a Cliente
                        </button>
                    </div>
                }
            </div>
        }
    </div>

</div>

@code {
    private decimal currentMonthSales = 0;
    private decimal currentMonthExpenses = 0;
    private decimal currentMonthUtility => currentMonthSales - currentMonthExpenses;
    private int totalFacturasMes = 0;
    private bool _firstRender = true;
    
    // Lista de citas para recordatorios de mañana
    private List<VeterinariaGenesis.Domain.Entities.Cita> recordatoriosManana = new();

    protected override async Task OnInitializedAsync()
    {
        AppState.OnChange += OnAppStateChanged;
        await AppState.LoadMascotasAsync();
        await AppState.LoadClientesAsync();
        await AppState.LoadFacturasAsync();
        await AppState.LoadGastosAsync();
        await AppState.LoadCitasAsync();
        RecalcularTodo();
    }

    // Recarga datos frescos de la API cada vez que el usuario navega al Dashboard
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            _firstRender = false;
            return;
        }
    }

    // Se llama automáticamente cuando AppState emite OnChange (por ejemplo, al crear una factura)
    private void OnAppStateChanged()
    {
        RecalcularTodo();
        StateHasChanged();
    }

    private void RecalcularTodo()
    {
        var hoy = DateTime.Now;
        var factMes = AppState.Facturas
            .Where(f => f.FechaEmision.Month == hoy.Month && f.FechaEmision.Year == hoy.Year)
            .ToList();

        currentMonthSales    = factMes.Sum(f => f.Total);
        currentMonthExpenses = AppState.Gastos
            .Where(g => g.Fecha.Month == hoy.Month && g.Fecha.Year == hoy.Year)
            .Sum(g => g.Monto);
        totalFacturasMes = factMes.Count;
        
        // Calcular citas de mañana que NO han sido notificadas y NO están canceladas
        var mañanaInicio = hoy.Date.AddDays(1);
        var mañanaFin = hoy.Date.AddDays(2).AddTicks(-1);
        
        recordatoriosManana = AppState.Citas
            .Where(c => c.FechaHora >= mañanaInicio && c.FechaHora <= mañanaFin)
            .Where(c => !c.NotificadoWhatsapp && c.Estado != "Cancelada" && c.Estado != "Completada")
            .OrderBy(c => c.FechaHora)
            .ToList();
    }

    private async Task EnviarNotificacionRapida(VeterinariaGenesis.Domain.Entities.Cita cita)
    {
        var cliente = AppState.Clientes.FirstOrDefault(c => c.Id == cita.ClienteId);
        if (cliente == null) return;
        
        var mascota = AppState.Mascotas.FirstOrDefault(m => m.Id == cita.MascotaId);
        var trabajador = AppState.Trabajadores.FirstOrDefault(t => t.Id == cita.TrabajadorId);

        var phone = string.IsNullOrEmpty(cliente.Telefono) ? "88888888" : new string(cliente.Telefono.Where(char.IsDigit).ToArray());
        var clientName = $"{cliente.Nombres} {cliente.Apellidos}".Trim();
        if (string.IsNullOrEmpty(clientName)) clientName = cliente.DisplayNombres ?? "Cliente";
        
        var petName = mascota?.Nombre ?? "tu mascota";
        var vetName = trabajador != null ? $"{trabajador.Nombres} {trabajador.Apellidos}" : "Veterinario Asignado";

        // Lógica Inteligente del Motivo
        string motivoLower = cita.Motivo.ToLower();
        string textoMotivo;
        
        if (motivoLower.Contains("vacuna") || motivoLower.Contains("desparasita"))
            textoMotivo = $"su aplicación de *{cita.Motivo.Trim()}*";
        else if (motivoLower.Contains("cirugia") || motivoLower.Contains("cirugía") || motivoLower.Contains("operacion") || motivoLower.Contains("operación"))
            textoMotivo = $"su procedimiento de *{cita.Motivo.Trim()}*";
        else if (motivoLower.Contains("consulta") || motivoLower.Contains("chequeo") || motivoLower.Contains("revision") || motivoLower.Contains("revisión"))
            textoMotivo = $"su *{cita.Motivo.Trim()}*";
        else
            textoMotivo = $"su cita para *{cita.Motivo.Trim()}*";

        // Generar Mensaje Inteligente
        var msg = $"Hola *{clientName}*, te escribimos de *Veterinaria Génesis* para recordarte que mañana {cita.FechaHora:dd/MM/yyyy} a las {cita.FechaHora:hh:mm tt}, {petName} tiene agendada {textoMotivo} con el Dr. {vetName}.\n\nTe recomendamos llegar 5 minutos antes. ¡Los esperamos!\n\n📍 Dir: Semáforos de la cañada 10 varas al este.\n📞 Tel: 8878-2492.";
        var encodedMsg = Uri.EscapeDataString(msg);

        // Guardar el log en el servidor para que quede registrado como enviado
        bool exito = await AppState.SendManualNotificationAsync(cita.Id);
        if (exito)
        {
            // Abre WhatsApp Web en una nueva pestaña pre-llenada
            var waUrl = $"https://api.whatsapp.com/send?phone=505{phone}&text={encodedMsg}";
            await JS.InvokeVoidAsync("open", waUrl, "_blank");
            
            // Recalcular la lista para que desaparezca visualmente
            RecalcularTodo();
        }
        else
        {
            await JS.InvokeVoidAsync("alert", "Ocurrió un problema al conectar con el servidor.");
        }
    }

    public void Dispose() => AppState.OnChange -= OnAppStateChanged;
}

