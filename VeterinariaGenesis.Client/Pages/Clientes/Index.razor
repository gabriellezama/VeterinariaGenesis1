@page "/clientes"
@inject VeterinariaGenesis.Client.Services.AppStateService AppState
@inject NavigationManager Nav
@implements IDisposable

<PageTitle>Clientes | Veterinaria Génesis</PageTitle>

<div class="page-transition">
    <div class="mb-6 flex flex-col md:flex-row md:items-center justify-between gap-4">
        <div>
            <h1 class="text-3xl font-black text-slate-900 tracking-tight">Directorio de Clientes</h1>
            <p class="text-slate-500">Gestiona la base de datos de dueños de mascotas.</p>
        </div>
        
        <div class="flex items-center gap-3">
            <div class="relative group">
                <i class="fas fa-search absolute left-4 top-1/2 -translate-y-1/2 text-slate-400 group-focus-within:text-indigo-500 transition-colors"></i>
                <input type="text" 
                       placeholder="Buscar por nombre o cédula..." 
                       class="pl-11 pr-4 py-3 bg-white border border-slate-200 rounded-2xl text-sm w-full md:w-80 shadow-sm focus:ring-2 focus:ring-indigo-500 focus:border-transparent transition-all outline-none"
                       @bind-value="searchTerm" @bind-value:event="oninput" />
            </div>
            
            <button @onclick='() => Nav.NavigateTo("clientes/crear")' 
                    class="bg-indigo-600 hover:bg-indigo-700 text-white px-6 py-3 rounded-2xl shadow-lg shadow-indigo-100 font-bold transition-all transform hover:-translate-y-1 flex items-center btn-pulse">
                <i class="fas fa-user-plus mr-2"></i> Nuevo
            </button>
        </div>
    </div>

    @if (!FilteredClientes.Any())
    {
        <div class="bg-white rounded-3xl p-12 text-center border border-dashed border-slate-200 animate-fade-in">
            <div class="w-20 h-20 bg-slate-50 rounded-full flex items-center justify-center mx-auto mb-4 text-slate-300 text-3xl">
                <i class="fas fa-users-slash"></i>
            </div>
            <h3 class="text-xl font-bold text-slate-700">No se encontraron clientes</h3>
            <p class="text-slate-400">Intenta con otro término de búsqueda o registra uno nuevo.</p>
        </div>
    }
    else
    {
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
            @foreach (var cliente in FilteredClientes)
            {
                <div class="bg-white rounded-3xl p-6 shadow-sm border border-slate-100 card-hover group relative overflow-hidden">
                    <div class="absolute top-0 right-0 p-4 opacity-0 group-hover:opacity-100 transition-opacity">
                        <button @onclick="() => EliminarCliente(cliente.Id)" class="text-rose-400 hover:text-rose-600 p-2"><i class="fas fa-trash"></i></button>
                    </div>
                    
                    <div class="flex items-start gap-4 mb-6">
                        <div class="w-14 h-14 rounded-2xl bg-gradient-to-br from-indigo-500 to-purple-600 flex items-center justify-center text-white text-xl font-bold shadow-lg shadow-indigo-100">
                            @(string.IsNullOrEmpty(cliente.Nombres) ? "?" : cliente.Nombres.Substring(0, 1).ToUpper())
                        </div>
                        <div>
                            <h3 class="text-lg font-black text-slate-800">@cliente.Nombres</h3>
                            <span class="text-xs font-bold text-slate-400 uppercase tracking-widest">ID: @cliente.Identificacion</span>
                        </div>
                    </div>

                    <div class="space-y-3 mb-6">
                        <div class="flex items-center text-slate-600 text-sm">
                            <i class="fas fa-phone-alt w-6 text-indigo-400"></i> @cliente.Telefono
                        </div>
                        <div class="flex items-center text-slate-600 text-sm">
                            <i class="fas fa-envelope w-6 text-indigo-400"></i> @cliente.Email
                        </div>
                    </div>

                    <button @onclick="() => VerFicha(cliente)" class="w-full py-3 bg-slate-50 hover:bg-indigo-600 hover:text-white text-indigo-600 rounded-xl font-bold text-sm transition-all flex items-center justify-center group/btn">
                        VER FICHA COMPLETA <i class="fas fa-arrow-right ml-2 group-hover/btn:translate-x-1 transition-transform"></i>
                    </button>
                </div>
            }
        </div>
    }
</div>

@if (clienteSeleccionado != null)
{
    <div class="fixed inset-0 bg-slate-900/60 backdrop-blur-sm z-50 flex items-center justify-center p-4">
        <div class="bg-white rounded-[2rem] shadow-2xl w-full max-w-4xl max-h-[90vh] overflow-hidden flex flex-col animate-zoom-in">
            <div class="p-8 bg-indigo-600 text-white flex justify-between items-start">
                <div class="flex gap-6">
                    <div class="w-20 h-20 rounded-3xl bg-white/20 backdrop-blur-md flex items-center justify-center text-3xl font-black border border-white/30">
                        @(string.IsNullOrEmpty(clienteSeleccionado.Nombres) ? "?" : clienteSeleccionado.Nombres.Substring(0, 1).ToUpper())
                    </div>
                    <div>
                        <h2 class="text-3xl font-black mb-1">@clienteSeleccionado.Nombres</h2>
                        <div class="flex gap-4 text-indigo-100 text-sm font-medium">
                            <span><i class="fas fa-id-card mr-1"></i> @clienteSeleccionado.Identificacion</span>
                            <span><i class="fas fa-map-marker-alt mr-1"></i> @clienteSeleccionado.Direccion</span>
                        </div>
                    </div>
                </div>
                <button @onclick="CerrarFicha" class="w-10 h-10 rounded-full bg-white/10 hover:bg-white/20 flex items-center justify-center text-xl transition-colors">&times;</button>
            </div>
            
            <div class="flex-1 overflow-y-auto p-8">
                <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
                    <div>
                        <h3 class="text-sm font-black text-slate-400 uppercase tracking-widest mb-4">Mascotas Vinculadas</h3>
                        <div class="space-y-4">
                            @foreach (var mascota in AppState.Mascotas.Where(m => m.ClienteId == clienteSeleccionado.Id))
                            {
                                <div class="p-4 bg-slate-50 rounded-2xl border border-slate-100 flex items-center justify-between group hover:bg-white hover:border-indigo-200 hover:shadow-md transition-all cursor-pointer" @onclick='() => Nav.NavigateTo($"historial-clinico/{mascota.Id}")'>
                                    <div class="flex items-center gap-3">
                                        <div class="w-12 h-12 rounded-xl bg-white flex items-center justify-center text-indigo-500 shadow-sm">
                                            <i class="fas @(mascota.Especie?.ToLower() == "perro" ? "fa-dog" : "fa-cat") text-xl"></i>
                                        </div>
                                        <div>
                                            <p class="font-bold text-slate-800">@mascota.Nombre</p>
                                            <p class="text-xs text-slate-400">@mascota.Raza • @mascota.Edad años</p>
                                        </div>
                                    </div>
                                    <i class="fas fa-chevron-right text-slate-300 group-hover:text-indigo-500 transition-colors"></i>
                                </div>
                            }
                            <button @onclick='() => Nav.NavigateTo($"mascotas/crear?clienteId={clienteSeleccionado.Id}")' class="w-full py-4 border-2 border-dashed border-slate-200 rounded-2xl text-slate-400 font-bold hover:border-indigo-300 hover:text-indigo-500 hover:bg-indigo-50 transition-all flex items-center justify-center gap-2">
                                <i class="fas fa-plus-circle"></i> VINCULAR NUEVA MASCOTA
                            </button>
                        </div>
                    </div>

                    <div>
                        <h3 class="text-sm font-black text-slate-400 uppercase tracking-widest mb-4">Historial de Visitas</h3>
                        <div class="space-y-4">
                            @foreach (var fact in AppState.Facturas.Where(f => f.ClienteId == clienteSeleccionado.Id).OrderByDescending(f => f.FechaEmision))
                            {
                                <div class="p-4 border-l-4 border-indigo-500 bg-white shadow-sm rounded-r-2xl flex justify-between items-center">
                                    <div>
                                        <p class="font-bold text-slate-800">Visita Médica / Venta</p>
                                        <p class="text-xs text-slate-400">@fact.FechaEmision.ToString("dd MMMM, yyyy")</p>
                                    </div>
                                    <p class="font-black text-indigo-600">C$ @fact.Total.ToString("N2")</p>
                                </div>
                            }
                            @if (!AppState.Facturas.Any(f => f.ClienteId == clienteSeleccionado.Id))
                            {
                                <div class="py-8 text-center text-slate-400 italic bg-slate-50 rounded-2xl">
                                    Sin historial de facturación
                                </div>
                            }
                        </div>
                    </div>
                </div>
            </div>
            
            <div class="p-6 bg-slate-50 border-t border-slate-100 flex justify-end gap-3">
                <button @onclick="CerrarFicha" class="px-6 py-2.5 font-bold text-slate-400 hover:text-slate-600 transition-colors">CERRAR</button>
                <button @onclick='() => Nav.NavigateTo($"clientes/editar/{clienteSeleccionado.Id}")' class="px-8 py-2.5 bg-indigo-600 text-white rounded-xl font-bold shadow-lg shadow-indigo-100 hover:bg-indigo-700 transition-all">EDITAR PERFIL</button>
            </div>
        </div>
    </div>
}

@code {
    private string searchTerm = "";
    private Cliente? clienteSeleccionado = null;

    private List<Cliente> FilteredClientes => AppState.Clientes
        .Where(c => string.IsNullOrWhiteSpace(searchTerm) || 
                    (c.Nombres != null && c.Nombres.Contains(searchTerm, StringComparison.OrdinalIgnoreCase)) ||
                    (c.Identificacion != null && c.Identificacion.Contains(searchTerm, StringComparison.OrdinalIgnoreCase)))
        .ToList();

    protected override async Task OnInitializedAsync()
    {
        AppState.OnChange += StateHasChanged;
        await AppState.LoadClientesAsync();
        await AppState.LoadMascotasAsync();
        await AppState.LoadFacturasAsync();
    }

    private void VerFicha(Cliente cliente) => clienteSeleccionado = cliente;
    private void CerrarFicha() => clienteSeleccionado = null;

    private async Task EliminarCliente(Guid id)
    {
        await AppState.DeleteClienteAsync(id);
    }

    public void Dispose()
    {
        AppState.OnChange -= StateHasChanged;
    }
}
