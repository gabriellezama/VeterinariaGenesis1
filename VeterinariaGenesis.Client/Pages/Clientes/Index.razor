@page "/clientes"
@implements IDisposable
@using VeterinariaGenesis.Client.Services
@using VeterinariaGenesis.Domain.Entities
@inject AppStateService AppState
@inject NavigationManager NavigationManager

<PageTitle>Clientes | Veterinaria Génesis</PageTitle>

<div class="mb-6 flex justify-between items-center">
    <div>
        <h1 class="text-2xl font-bold text-gray-900">Directorio de Clientes</h1>
        <p class="text-sm text-gray-500">Gestiona la información de dueños y sus mascotas.</p>
    </div>
    
    <button @onclick='() => NavigationManager.NavigateTo("clientes/crear")' class="bg-indigo-600 hover:bg-indigo-700 text-white px-4 py-2 rounded-lg shadow-md font-medium transition-colors flex items-center">
        <i class="fas fa-plus mr-2"></i> Nuevo Cliente
    </button>
</div>

<!-- Filtros -->
<div class="bg-white p-4 rounded-xl shadow-sm border border-gray-100 mb-6 flex flex-wrap gap-4 items-center">
    <div class="relative flex-1 min-w-[200px]">
        <span class="absolute inset-y-0 left-0 pl-3 flex items-center">
            <i class="fas fa-search text-gray-400"></i>
        </span>
        <input type="text" class="block w-full pl-10 pr-3 py-2 border border-gray-200 rounded-lg text-sm placeholder-gray-500 focus:outline-none focus:ring-1 focus:ring-indigo-500 focus:border-indigo-500" placeholder="Buscar por nombre, teléfono o email...">
    </div>
    <button class="bg-gray-50 hover:bg-gray-100 text-gray-700 px-4 py-2 rounded-lg border border-gray-200 font-medium transition-colors">
        <i class="fas fa-filter"></i> Filtros
    </button>
</div>

<!-- Tabla de Clientes -->
<div class="bg-white rounded-xl shadow-sm border border-gray-100 overflow-hidden">
    <div class="overflow-x-auto">
        <table class="w-full text-left border-collapse">
            <thead>
                <tr class="bg-gray-50 text-gray-500 text-xs uppercase tracking-wider">
                    <th class="px-6 py-4 font-medium">Cliente</th>
                    <th class="px-6 py-4 font-medium">Contacto</th>
                    <th class="px-6 py-4 font-medium">Mascotas</th>
                    <th class="px-6 py-4 font-medium text-right">Acciones</th>
                </tr>
            </thead>
            <tbody class="divide-y divide-gray-100 text-sm">
                @foreach (var cliente in AppState.Clientes)
                {
                    <tr class="hover:bg-gray-50 transition-colors">
                        <td class="px-6 py-4">
                            <div class="flex items-center">
                                <div class="h-10 w-10 rounded-full bg-indigo-100 flex items-center justify-center text-indigo-600 font-bold">
                                    @(cliente.Nombres.FirstOrDefault())@(cliente.Apellidos.FirstOrDefault())
                                </div>
                                <div class="ml-4">
                                    <div class="font-medium text-gray-900">@cliente.Nombres @cliente.Apellidos</div>
                                    <div class="text-xs text-gray-500">ID: @cliente.Id.ToString().Substring(0, 8)</div>
                                </div>
                            </div>
                        </td>
                        <td class="px-6 py-4">
                            <div class="text-gray-900"><i class="fas fa-phone-alt text-gray-400 mr-2 text-xs"></i> @cliente.Telefono</div>
                            <div class="text-gray-500 text-xs"><i class="far fa-envelope text-gray-400 mr-2"></i> @cliente.Email</div>
                        </td>
                        <td class="px-6 py-4">
                            @foreach (var mascota in AppState.Mascotas.Where(m => m.ClienteId == cliente.Id))
                            {
                                <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-blue-100 text-blue-800 mr-2 mt-1">
                                    <i class="fas @(mascota.Especie.ToLower() == "gato" ? "fa-cat" : "fa-dog") mr-1"></i> @mascota.Nombre
                                </span>
                            }
                        </td>
                        <td class="px-6 py-4 text-right">
                            <a href="https://wa.me/@(cliente.Telefono?.Replace(" ", "").Replace("-", ""))" target="_blank" class="text-green-600 hover:text-green-900 p-2" title="Enviar WhatsApp">
                                <i class="fab fa-whatsapp"></i>
                            </a>
                            <button @onclick='() => NavigationManager.NavigateTo($"/mascotas/crear/{cliente.Id}")' class="text-indigo-600 hover:text-indigo-900 p-2" title="Agregar Mascota">
                                <i class="fas fa-paw"></i>
                            </button>
                            <button class="text-blue-600 hover:text-blue-900 p-2" title="Editar">
                                <i class="fas fa-edit"></i>
                            </button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

@code {
    protected override async Task OnInitializedAsync()
    {
        AppState.OnChange += StateHasChanged;
        await AppState.LoadClientesAsync();
        await AppState.LoadMascotasAsync();
    }

    public void Dispose()
    {
        AppState.OnChange -= StateHasChanged;
    }
}
