@page "/clientes/crear"
@using VeterinariaGenesis.Client.Services
@using VeterinariaGenesis.Domain.Entities
@inject AppStateService AppState
@inject NavigationManager NavigationManager

<PageTitle>Nuevo Cliente | Veterinaria Génesis</PageTitle>

<div class="mb-6 flex justify-between items-center">
    <div>
        <button @onclick="Volver" class="text-gray-500 hover:text-indigo-600 mb-2 flex items-center transition-colors">
            <i class="fas fa-arrow-left mr-2"></i> Volver al directorio
        </button>
        <h1 class="text-2xl font-bold text-gray-900">Registrar Nuevo Cliente</h1>
    </div>
</div>

<div class="bg-white rounded-xl shadow-sm border border-gray-100 overflow-hidden">
    <EditForm Model="nuevoCliente" OnValidSubmit="GuardarCliente">
        <div class="p-6">
            <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                <!-- Datos Personales -->
                <div class="space-y-4">
                    <h3 class="text-lg font-medium text-gray-900 border-b pb-2">Datos Personales</h3>
                    
                    <div>
                        <label class="block text-sm font-medium text-gray-700 mb-1">Nombres</label>
                        <InputText @bind-Value="nuevoCliente.Nombres" class="w-full pl-3 pr-3 py-2 border border-gray-200 rounded-lg text-sm focus:outline-none focus:ring-1 focus:ring-indigo-500 focus:border-indigo-500" placeholder="Ej. Juan Carlos" required />
                    </div>
                    
                    <div>
                        <label class="block text-sm font-medium text-gray-700 mb-1">Apellidos</label>
                        <InputText @bind-Value="nuevoCliente.Apellidos" class="w-full pl-3 pr-3 py-2 border border-gray-200 rounded-lg text-sm focus:outline-none focus:ring-1 focus:ring-indigo-500 focus:border-indigo-500" placeholder="Ej. Pérez" required />
                    </div>
                    
                    <div>
                        <label class="block text-sm font-medium text-gray-700 mb-1">Identificación / DNI</label>
                        <InputText @bind-Value="nuevoCliente.Identificacion" class="w-full pl-3 pr-3 py-2 border border-gray-200 rounded-lg text-sm focus:outline-none focus:ring-1 focus:ring-indigo-500 focus:border-indigo-500" placeholder="Número de documento" />
                    </div>
                </div>
                
                <!-- Datos de Contacto -->
                <div class="space-y-4">
                    <h3 class="text-lg font-medium text-gray-900 border-b pb-2">Información de Contacto</h3>
                    
                    <div>
                        <label class="block text-sm font-medium text-gray-700 mb-1">Teléfono</label>
                        <InputText @bind-Value="nuevoCliente.Telefono" class="w-full pl-3 pr-3 py-2 border border-gray-200 rounded-lg text-sm focus:outline-none focus:ring-1 focus:ring-indigo-500 focus:border-indigo-500" placeholder="Ej. 555-1234" required />
                    </div>
                    
                    <div>
                        <label class="block text-sm font-medium text-gray-700 mb-1">Correo Electrónico</label>
                        <InputText @bind-Value="nuevoCliente.Email" type="email" class="w-full pl-3 pr-3 py-2 border border-gray-200 rounded-lg text-sm focus:outline-none focus:ring-1 focus:ring-indigo-500 focus:border-indigo-500" placeholder="ejemplo@correo.com" />
                    </div>
                    
                    <div>
                        <label class="block text-sm font-medium text-gray-700 mb-1">Dirección</label>
                        <InputTextArea @bind-Value="nuevoCliente.Direccion" rows="3" class="w-full pl-3 pr-3 py-2 border border-gray-200 rounded-lg text-sm focus:outline-none focus:ring-1 focus:ring-indigo-500 focus:border-indigo-500" placeholder="Dirección completa" />
                    </div>
                </div>
            </div>
        </div>
        
        <div class="bg-gray-50 px-6 py-4 border-t border-gray-100 flex justify-end space-x-3">
            <button type="button" @onclick="Volver" class="px-4 py-2 border border-gray-300 rounded-lg text-sm font-medium text-gray-700 hover:bg-gray-50 transition-colors">
                Cancelar
            </button>
            <button type="submit" class="px-4 py-2 bg-indigo-600 border border-transparent rounded-lg text-sm font-medium text-white hover:bg-indigo-700 shadow-sm transition-colors flex items-center">
                <i class="fas fa-save mr-2"></i> Guardar Cliente
            </button>
        </div>
    </EditForm>
</div>

@code {
    private Cliente nuevoCliente = new Cliente();

    private async Task GuardarCliente()
    {
        await AppState.AddClienteAsync(nuevoCliente);
        NavigationManager.NavigateTo("/clientes");
    }

    private void Volver()
    {
        NavigationManager.NavigateTo("/clientes");
    }
}
