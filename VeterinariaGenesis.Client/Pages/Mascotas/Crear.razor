@page "/mascotas/crear/{ClienteId:guid}"
@using VeterinariaGenesis.Client.Services
@using VeterinariaGenesis.Domain.Entities
@using System.ComponentModel.DataAnnotations
@inject AppStateService AppState
@inject NavigationManager NavigationManager
@inject IJSRuntime JS

<PageTitle>Vincular Mascota | Veterinaria Génesis</PageTitle>

<div class="max-w-4xl mx-auto pb-12 animate-fade-in">
    <!-- Header Premium -->
    <div class="mb-8 flex flex-col md:flex-row md:items-center justify-between gap-4">
        <div>
            <button @onclick="Volver" class="text-slate-400 hover:text-indigo-600 mb-3 flex items-center font-bold text-sm uppercase tracking-wider transition-all group">
                <i class="fas fa-arrow-left mr-2 group-hover:-translate-x-1 transition-transform"></i> Volver al Directorio
            </button>
            <h1 class="text-3xl font-black text-slate-900 flex items-center gap-3">
                <span class="w-12 h-12 bg-indigo-100 text-indigo-600 rounded-2xl flex items-center justify-center">
                    <i class="fas fa-paw"></i>
                </span>
                Registrar Nuevo Paciente
            </h1>
        </div>
        <div class="bg-white px-5 py-3 rounded-2xl shadow-sm border border-slate-100 flex items-center gap-3">
            <div class="w-10 h-10 rounded-full bg-slate-100 flex items-center justify-center text-slate-500 font-bold">
                <i class="fas fa-user"></i>
            </div>
            <div>
                <p class="text-[0.65rem] font-black text-slate-400 uppercase tracking-widest">Vinculando al Dueño:</p>
                <p class="font-bold text-slate-800">@nombreCliente</p>
            </div>
        </div>
    </div>

    <!-- Formulario Premium -->
    <div class="bg-white rounded-[2rem] shadow-xl shadow-indigo-100/20 border border-slate-100 overflow-hidden">
        <EditForm Model="nuevaMascota" OnValidSubmit="GuardarMascota">
            <DataAnnotationsValidator />
            
            @if (mostrarError)
            {
                <div class="m-6 mb-0 p-4 bg-rose-50 border border-rose-100 rounded-2xl text-rose-600 text-sm font-bold flex items-center gap-3 animate-shake">
                    <i class="fas fa-exclamation-circle text-rose-500 text-lg"></i>
                    <span>@mensajeError</span>
                </div>
            }

            <div class="p-8">
                <div class="grid grid-cols-1 md:grid-cols-12 gap-8">
                    
                    <!-- Columna Izquierda: Foto y Resumen -->
                    <div class="md:col-span-4 space-y-6">
                        <div class="bg-slate-50 rounded-[1.5rem] p-6 border border-slate-100 text-center flex flex-col items-center">
                            <div class="mb-4 flex flex-col items-center">
                                <div class="w-32 h-32 rounded-full border-4 border-white shadow-lg overflow-hidden bg-white flex items-center justify-center relative mb-3">
                                    @if (!string.IsNullOrWhiteSpace(nuevaMascota.FotoBase64))
                                    {
                                        <img src="@nuevaMascota.FotoBase64" class="w-full h-full object-cover" />
                                    }
                                    else
                                    {
                                        <i class="fas @(nuevaMascota.Especie == "Gato" ? "fa-cat" : "fa-dog") text-5xl text-slate-200"></i>
                                    }
                                </div>
                                
                                <div class="relative w-full">
                                    <button type="button" class="bg-white border border-indigo-200 text-indigo-600 text-xs font-bold uppercase tracking-wider py-2 px-4 rounded-xl shadow-sm hover:bg-indigo-50 transition-colors w-full flex items-center justify-center gap-2">
                                        <i class="fas fa-camera"></i> Subir Foto
                                    </button>
                                    <InputFile OnChange="OnInputFileChange" accept="image/*" class="absolute inset-0 w-full h-full opacity-0 cursor-pointer" />
                                </div>
                            </div>
                            <h3 class="font-black text-slate-800 text-lg">@(string.IsNullOrWhiteSpace(nuevaMascota.Nombre) ? "Sin Nombre" : nuevaMascota.Nombre)</h3>
                            <p class="text-xs font-bold text-indigo-500 uppercase tracking-widest mt-1">
                                @(string.IsNullOrWhiteSpace(nuevaMascota.Especie) ? "ESPECIE" : nuevaMascota.Especie) 
                                @(string.IsNullOrWhiteSpace(nuevaMascota.Raza) ? "" : $" • {nuevaMascota.Raza}")
                            </p>
                        </div>

                        <div class="bg-indigo-50/50 rounded-2xl p-5 border border-indigo-100/50">
                            <h4 class="text-xs font-black text-indigo-800 uppercase tracking-widest mb-3 flex items-center gap-2">
                                <i class="fas fa-info-circle"></i> Consejos
                            </h4>
                            <ul class="text-xs text-indigo-600/80 space-y-2 font-medium">
                                <li>• Sube una foto clara para identificar fácilmente al paciente.</li>
                                <li>• Completa todos los datos clínicos para un mejor historial.</li>
                                <li>• El peso es vital para calcular dosis médicas.</li>
                            </ul>
                        </div>
                    </div>

                    <!-- Columna Derecha: Campos Clínicos -->
                    <div class="md:col-span-8 space-y-5">
                        <div class="border-b border-slate-100 pb-3 mb-6">
                            <h3 class="text-lg font-black text-slate-800">Ficha Médica Básica</h3>
                        </div>

                        <div>
                            <label class="block text-xs font-black text-slate-400 uppercase tracking-widest mb-1.5 ml-1">Nombre del Paciente <span class="text-rose-500">*</span></label>
                            <InputText @bind-Value="nuevaMascota.Nombre" class="w-full px-4 py-3 bg-slate-50 border border-slate-200 rounded-xl text-slate-800 font-medium focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:bg-white transition-all shadow-sm" placeholder="Ej. Max, Luna, Firulais..." required />
                        </div>
                        
                        <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
                            <div>
                                <label class="block text-xs font-black text-slate-400 uppercase tracking-widest mb-1.5 ml-1">Especie <span class="text-rose-500">*</span></label>
                                <InputSelect @bind-Value="nuevaMascota.Especie" class="w-full px-4 py-3 bg-slate-50 border border-slate-200 rounded-xl text-slate-800 font-medium focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:bg-white transition-all shadow-sm appearance-none" required>
                                    <option value="">-- Seleccionar --</option>
                                    <option value="Perro">Perro (Canino)</option>
                                    <option value="Gato">Gato (Felino)</option>
                                    <option value="Ave">Ave</option>
                                    <option value="Roedor">Roedor</option>
                                    <option value="Reptil">Reptil</option>
                                    <option value="Exótico">Animal Exótico</option>
                                </InputSelect>
                            </div>
                            <div>
                                <label class="block text-xs font-black text-slate-400 uppercase tracking-widest mb-1.5 ml-1">Raza</label>
                                <InputText @bind-Value="nuevaMascota.Raza" class="w-full px-4 py-3 bg-slate-50 border border-slate-200 rounded-xl text-slate-800 font-medium focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:bg-white transition-all shadow-sm" placeholder="Ej. Golden Retriever, Siames..." />
                            </div>
                        </div>
                        
                        <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
                            <div>
                                <label class="block text-xs font-black text-slate-400 uppercase tracking-widest mb-1.5 ml-1">Edad Estimada (Años)</label>
                                <div class="relative">
                                    <InputNumber @bind-Value="nuevaMascota.Edad" min="0" max="40" class="w-full px-4 py-3 bg-slate-50 border border-slate-200 rounded-xl text-slate-800 font-medium focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:bg-white transition-all shadow-sm" />
                                    <div class="absolute inset-y-0 right-0 pr-4 flex items-center pointer-events-none">
                                        <span class="text-slate-400 text-sm font-bold">años</span>
                                    </div>
                                </div>
                            </div>
                            <div>
                                <label class="block text-xs font-black text-slate-400 uppercase tracking-widest mb-1.5 ml-1">Sexo <span class="text-rose-500">*</span></label>
                                <InputSelect @bind-Value="nuevaMascota.Sexo" class="w-full px-4 py-3 bg-slate-50 border border-slate-200 rounded-xl text-slate-800 font-medium focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:bg-white transition-all shadow-sm appearance-none" required>
                                    <option value="">-- Seleccionar --</option>
                                    <option value="Macho">Macho</option>
                                    <option value="Hembra">Hembra</option>
                                    <option value="Desconocido">Desconocido</option>
                                </InputSelect>
                            </div>
                        </div>
                        
                        <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
                            <div>
                                <label class="block text-xs font-black text-slate-400 uppercase tracking-widest mb-1.5 ml-1">Peso (kg)</label>
                                <div class="relative">
                                    <InputNumber @bind-Value="nuevaMascota.Peso" step="0.1" class="w-full px-4 py-3 bg-slate-50 border border-slate-200 rounded-xl text-slate-800 font-medium focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:bg-white transition-all shadow-sm" placeholder="0.00" />
                                    <div class="absolute inset-y-0 right-0 pr-4 flex items-center pointer-events-none">
                                        <span class="text-slate-400 text-sm font-bold">kg</span>
                                    </div>
                                </div>
                            </div>
                            <div>
                                <label class="block text-xs font-black text-slate-400 uppercase tracking-widest mb-1.5 ml-1">Pelaje / Color</label>
                                <InputText @bind-Value="nuevaMascota.Color" class="w-full px-4 py-3 bg-slate-50 border border-slate-200 rounded-xl text-slate-800 font-medium focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:bg-white transition-all shadow-sm" placeholder="Ej: Blanco con manchas negras" />
                            </div>
                        </div>

                        <!-- NUEVA SECCION: Salud Preventiva Inicial -->
                        <div class="border-b border-slate-100 pb-3 mt-8 mb-6">
                            <h3 class="text-lg font-black text-slate-800 flex items-center gap-2">
                                <i class="fas fa-heartbeat text-rose-500"></i> Salud Preventiva Inicial
                            </h3>
                        </div>

                        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                            <!-- Vacunas -->
                            <div class="bg-emerald-50 p-5 rounded-2xl border border-emerald-100 transition-all @(nuevaMascota.TieneVacunas ? "shadow-md" : "")">
                                <label class="flex items-center gap-3 cursor-pointer mb-4">
                                    <div class="relative flex items-center">
                                        <InputCheckbox @bind-Value="nuevaMascota.TieneVacunas" class="w-5 h-5 rounded border-emerald-300 text-emerald-600 focus:ring-emerald-500 cursor-pointer" />
                                    </div>
                                    <span class="text-sm font-black text-emerald-700 uppercase tracking-widest">¿Está Vacunado?</span>
                                </label>
                                
                                @if (nuevaMascota.TieneVacunas)
                                {
                                    <div class="space-y-4 mt-4 animate-fade-in border-t border-emerald-100/50 pt-4">
                                        <div>
                                            <label class="block text-xs font-bold text-emerald-600/80 uppercase tracking-widest mb-1.5 ml-1">Vacunas Aplicadas</label>
                                            <InputText @bind-Value="nuevaMascota.DetalleVacunas" class="w-full px-4 py-3 bg-white border border-emerald-200 rounded-xl text-slate-800 text-sm focus:outline-none focus:ring-2 focus:ring-emerald-500 shadow-sm transition-all" placeholder="Ej: Rabia, Sextuple..." />
                                        </div>
                                        <div>
                                            <label class="block text-xs font-bold text-emerald-600/80 uppercase tracking-widest mb-1.5 ml-1">Próxima Vacunación</label>
                                            <InputDate @bind-Value="nuevaMascota.FechaProximaVacuna" class="w-full px-4 py-3 bg-white border border-emerald-200 rounded-xl text-slate-800 text-sm focus:outline-none focus:ring-2 focus:ring-emerald-500 shadow-sm transition-all" />
                                        </div>
                                    </div>
                                }
                            </div>

                            <!-- Desparasitación -->
                            <div class="bg-amber-50 p-5 rounded-2xl border border-amber-100 transition-all @(nuevaMascota.EstaDesparasitado ? "shadow-md" : "")">
                                <label class="flex items-center gap-3 cursor-pointer mb-4">
                                    <div class="relative flex items-center">
                                        <InputCheckbox @bind-Value="nuevaMascota.EstaDesparasitado" class="w-5 h-5 rounded border-amber-300 text-amber-600 focus:ring-amber-500 cursor-pointer" />
                                    </div>
                                    <span class="text-sm font-black text-amber-700 uppercase tracking-widest">¿Está Desparasitado?</span>
                                </label>
                                
                                @if (nuevaMascota.EstaDesparasitado)
                                {
                                    <div class="space-y-4 mt-4 animate-fade-in border-t border-amber-100/50 pt-4">
                                        <div>
                                            <label class="block text-xs font-bold text-amber-600/80 uppercase tracking-widest mb-1.5 ml-1">Desparasitante Aplicado</label>
                                            <InputText @bind-Value="nuevaMascota.DetalleDesparasitante" class="w-full px-4 py-3 bg-white border border-amber-200 rounded-xl text-slate-800 text-sm focus:outline-none focus:ring-2 focus:ring-amber-500 shadow-sm transition-all" placeholder="Ej: Drontal, Simparica..." />
                                        </div>
                                        <div>
                                            <label class="block text-xs font-bold text-amber-600/80 uppercase tracking-widest mb-1.5 ml-1">Próxima Desparasitación</label>
                                            <InputDate @bind-Value="nuevaMascota.FechaProximaDesparasitacion" class="w-full px-4 py-3 bg-white border border-amber-200 rounded-xl text-slate-800 text-sm focus:outline-none focus:ring-2 focus:ring-amber-500 shadow-sm transition-all" />
                                        </div>
                                    </div>
                                }
                            </div>
                        </div>

                    </div>
                </div>
            </div>
            
            <div class="bg-slate-50 p-6 border-t border-slate-100 flex flex-col-reverse sm:flex-row justify-end gap-3">
                <button type="button" @onclick="Volver" class="px-6 py-3 bg-white border border-slate-200 rounded-xl text-sm font-bold text-slate-600 hover:bg-slate-50 hover:text-slate-900 transition-all shadow-sm">
                    Cancelar
                </button>
                <button type="submit" disabled="@isSubmitting" class="px-8 py-3 bg-indigo-600 border border-transparent rounded-xl text-sm font-bold text-white hover:bg-indigo-700 shadow-lg shadow-indigo-100 transition-all flex items-center justify-center min-w-[200px] disabled:opacity-50 disabled:cursor-not-allowed">
                    @if (isSubmitting)
                    {
                        <i class="fas fa-spinner fa-spin mr-2"></i> <span>Guardando...</span>
                    }
                    else
                    {
                        <i class="fas fa-save mr-2"></i> <span>Guardar Paciente</span>
                    }
                </button>
            </div>
        </EditForm>
    </div>
</div>

@code {
    [Parameter]
    public Guid ClienteId { get; set; }

    private Mascota nuevaMascota = new Mascota();
    private string nombreCliente = string.Empty;
    private bool isSubmitting = false;
    private bool mostrarError = false;
    private string mensajeError = "";

    protected override async Task OnInitializedAsync()
    {
        if (!AppState.Clientes.Any())
        {
            await AppState.LoadClientesAsync();
        }

        var cliente = AppState.Clientes.FirstOrDefault(c => c.Id == ClienteId);
        if (cliente != null)
        {
            nombreCliente = $"{cliente.DisplayNombres} {cliente.Apellidos}".Trim();
            if (string.IsNullOrEmpty(nombreCliente)) nombreCliente = cliente.DisplayNombres ?? "Cliente Sin Nombre";
            
            nuevaMascota.ClienteId = ClienteId;
            nuevaMascota.Id = Guid.NewGuid();
        }
        else
        {
            NavigationManager.NavigateTo("clientes");
        }
    }

    private async Task GuardarMascota()
    {
        if (string.IsNullOrWhiteSpace(nuevaMascota.Nombre))
        {
            MostrarError("El nombre de la mascota es obligatorio.");
            return;
        }
        if (string.IsNullOrWhiteSpace(nuevaMascota.Especie))
        {
            MostrarError("Debes seleccionar la especie de la mascota.");
            return;
        }
        if (string.IsNullOrWhiteSpace(nuevaMascota.Sexo))
        {
            MostrarError("Debes seleccionar el sexo de la mascota.");
            return;
        }

        mostrarError = false;
        isSubmitting = true;
        StateHasChanged();

        try
        {
            var success = await AppState.AddMascotaAsync(nuevaMascota);
            if (success)
            {
                await JS.InvokeVoidAsync("alert", $"¡La mascota {nuevaMascota.Nombre} ha sido vinculada exitosamente a {nombreCliente}!");
                NavigationManager.NavigateTo("clientes");
            }
            else
            {
                MostrarError("Ocurrió un error al guardar en el servidor. Revisa tu conexión.");
            }
        }
        catch (Exception)
        {
            MostrarError("Error crítico al intentar guardar la mascota.");
        }
        finally
        {
            isSubmitting = false;
            StateHasChanged();
        }
    }

    private void MostrarError(string mensaje)
    {
        mostrarError = true;
        mensajeError = mensaje;
    }

    private void Volver()
    {
        NavigationManager.NavigateTo("clientes");
    }

    private async Task OnInputFileChange(InputFileChangeEventArgs e)
    {
        var file = e.File;
        if (file != null)
        {
            if (file.Size > 5 * 1024 * 1024)
            {
                MostrarError("La imagen es demasiado grande. Máximo 5MB.");
                return;
            }
            
            mostrarError = false;
            try
            {
                var buffer = new byte[file.Size];
                await file.OpenReadStream(maxAllowedSize: 5 * 1024 * 1024).ReadAsync(buffer);
                nuevaMascota.FotoBase64 = $"data:{file.ContentType};base64,{Convert.ToBase64String(buffer)}";
            }
            catch (Exception)
            {
                MostrarError("Error al procesar la imagen. Intenta con otra.");
            }
        }
    }
}
