@page "/proveedores"
@implements IDisposable
@using VeterinariaGenesis.Client.Services
@using VeterinariaGenesis.Domain.Entities
@inject AppStateService AppState
@inject NavigationManager NavigationManager

<PageTitle>Proveedores | Veterinaria Génesis</PageTitle>

<div class="mb-6 flex justify-between items-center">
    <div>
        <h1 class="text-2xl font-bold text-gray-900">Gestión de Proveedores</h1>
        <p class="text-sm text-gray-500">Administra las empresas y contactos que suministran tus productos.</p>
    </div>
    
    <button @onclick="AbrirModalNuevo" class="bg-indigo-600 hover:bg-indigo-700 text-white px-4 py-2 rounded-lg shadow-md font-medium transition-colors flex items-center">
        <i class="fas fa-plus mr-2"></i> Nuevo Proveedor
    </button>
</div>

<!-- Lista de Proveedores -->
<div class="bg-white rounded-xl shadow-sm border border-gray-100 overflow-hidden">
    <div class="overflow-x-auto">
        <table class="w-full text-left border-collapse">
            <thead>
                <tr class="bg-gray-50 text-gray-500 text-xs uppercase tracking-wider">
                    <th class="px-6 py-4 font-medium">Empresa e Información</th>
                    <th class="px-6 py-4 font-medium">Contacto Principal</th>
                    <th class="px-6 py-4 font-medium">Comunicación</th>
                    <th class="px-6 py-4 font-medium text-right">Acciones</th>
                </tr>
            </thead>
            <tbody class="divide-y divide-gray-100 text-sm">
                @if (!AppState.Proveedores.Any())
                {
                    <tr>
                        <td colspan="4" class="px-6 py-12 text-center">
                            <div class="flex flex-col items-center">
                                <i class="fas fa-truck-loading text-gray-200 text-5xl mb-4"></i>
                                <p class="text-gray-400 font-medium">No hay proveedores registrados aún.</p>
                                <p class="text-gray-300 text-xs">Añade tu primer proveedor para gestionar compras.</p>
                            </div>
                        </td>
                    </tr>
                }
                else
                {
                    @foreach (var prov in AppState.Proveedores)
                    {
                        <tr class="hover:bg-gray-50 transition-colors">
                            <td class="px-6 py-4">
                                <div class="flex flex-col">
                                    <span class="font-bold text-indigo-900 text-base">@prov.NombreEmpresa</span>
                                    <span class="text-xs text-gray-500 flex items-center mt-1">
                                        <i class="fas fa-map-marker-alt mr-1 text-red-400"></i> @(string.IsNullOrEmpty(prov.Direccion) ? "Dirección no especificada" : prov.Direccion)
                                    </span>
                                </div>
                            </td>
                            <td class="px-6 py-4">
                                <div class="flex flex-col">
                                    <span class="font-medium text-gray-900">@prov.Contacto</span>
                                    <span class="text-xs text-gray-500">@prov.Email</span>
                                </div>
                            </td>
                            <td class="px-6 py-4">
                                <div class="flex items-center space-x-3">
                                    <div class="flex flex-col">
                                        <span class="text-gray-900 font-medium">@prov.Telefono</span>
                                    </div>
                                    <a href="https://wa.me/@(prov.Telefono?.Replace("+", "").Replace(" ", ""))" target="_blank" class="w-8 h-8 rounded-full bg-green-100 text-green-600 flex items-center justify-center hover:bg-green-600 hover:text-white transition-all shadow-sm" title="Contactar por WhatsApp">
                                        <i class="fab fa-whatsapp"></i>
                                    </a>
                                </div>
                            </td>
                            <td class="px-6 py-4 text-right">
                                <div class="flex justify-end space-x-2">
                                    <button class="w-8 h-8 rounded-lg bg-blue-50 text-blue-600 hover:bg-blue-600 hover:text-white transition-colors"><i class="fas fa-edit text-xs"></i></button>
                                    <button class="w-8 h-8 rounded-lg bg-red-50 text-red-600 hover:bg-red-600 hover:text-white transition-colors"><i class="fas fa-trash text-xs"></i></button>
                                </div>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>

<!-- Modal para Nuevo Proveedor -->
@if (mostrarModal)
{
    <div class="fixed inset-0 bg-slate-900/60 backdrop-blur-sm z-50 flex items-center justify-center p-4">
        <div class="bg-white rounded-3xl shadow-2xl w-full max-w-lg overflow-hidden animate-zoom-in">
            <div class="bg-indigo-600 px-8 py-6 flex justify-between items-center">
                <h3 class="text-white font-bold text-xl flex items-center">
                    <i class="fas fa-truck mr-3"></i> Registrar Proveedor
                </h3>
                <button @onclick="CerrarModal" class="text-white/80 hover:text-white text-2xl">&times;</button>
            </div>
            
            <EditForm Model="nuevoProveedor" OnValidSubmit="GuardarProveedor">
                <div class="p-8 grid grid-cols-1 md:grid-cols-2 gap-5">
                    <div class="md:col-span-2">
                        <label class="block text-xs font-bold text-gray-500 uppercase mb-1">Nombre de la Empresa</label>
                        <InputText @bind-Value="nuevoProveedor.NombreEmpresa" class="w-full px-4 py-3 bg-gray-50 border border-gray-100 rounded-xl text-sm focus:bg-white focus:ring-2 focus:ring-indigo-500 transition-all" placeholder="Ej. Distribuidora Médica" required />
                    </div>
                    <div>
                        <label class="block text-xs font-bold text-gray-500 uppercase mb-1">Persona de Contacto</label>
                        <InputText @bind-Value="nuevoProveedor.Contacto" class="w-full px-4 py-3 bg-gray-50 border border-gray-100 rounded-xl text-sm focus:bg-white focus:ring-2 focus:ring-indigo-500 transition-all" placeholder="Nombre del agente" />
                    </div>
                    <div>
                        <label class="block text-xs font-bold text-gray-500 uppercase mb-1">Teléfono (WhatsApp)</label>
                        <InputText @bind-Value="nuevoProveedor.Telefono" class="w-full px-4 py-3 bg-gray-50 border border-gray-100 rounded-xl text-sm focus:bg-white focus:ring-2 focus:ring-indigo-500 transition-all" placeholder="Ej. +50588888888" />
                    </div>
                    <div class="md:col-span-2">
                        <label class="block text-xs font-bold text-gray-500 uppercase mb-1">Correo Electrónico</label>
                        <InputText @bind-Value="nuevoProveedor.Email" type="email" class="w-full px-4 py-3 bg-gray-50 border border-gray-100 rounded-xl text-sm focus:bg-white focus:ring-2 focus:ring-indigo-500 transition-all" placeholder="ventas@empresa.com" />
                    </div>
                    <div class="md:col-span-2">
                        <label class="block text-xs font-bold text-gray-500 uppercase mb-1">Dirección Física</label>
                        <InputTextArea @bind-Value="nuevoProveedor.Direccion" rows="2" class="w-full px-4 py-3 bg-gray-50 border border-gray-100 rounded-xl text-sm focus:bg-white focus:ring-2 focus:ring-indigo-500 transition-all" placeholder="Ubicación de la oficina/bodega" />
                    </div>
                </div>

                <div class="bg-gray-50 px-8 py-5 flex justify-end space-x-3">
                    <button type="button" @onclick="CerrarModal" class="px-5 py-2 text-sm font-bold text-gray-400 hover:text-gray-600 transition-colors">DESCARTAR</button>
                    <button type="submit" class="bg-indigo-600 text-white px-8 py-2.5 rounded-xl font-bold hover:bg-indigo-700 shadow-lg shadow-indigo-200 transition-all transform hover:-translate-y-1">
                        GUARDAR PROVEEDOR
                    </button>
                </div>
            </EditForm>
        </div>
    </div>
}

@code {
    private bool mostrarModal = false;
    private Proveedor nuevoProveedor = new Proveedor();

    protected override async Task OnInitializedAsync()
    {
        AppState.OnChange += StateHasChanged;
        await AppState.LoadProveedoresAsync();
    }

    private void AbrirModalNuevo()
    {
        nuevoProveedor = new Proveedor();
        mostrarModal = true;
    }

    private void CerrarModal() => mostrarModal = false;

    private async Task GuardarProveedor()
    {
        await AppState.AddProveedorAsync(nuevoProveedor);
        mostrarModal = false;
        await AppState.LoadProveedoresAsync();
    }

    public void Dispose()
    {
        AppState.OnChange -= StateHasChanged;
    }
}
