@page "/trabajadores"
@implements IDisposable
@using VeterinariaGenesis.Client.Services
@using VeterinariaGenesis.Domain.Entities
@inject AppStateService AppState
@inject NavigationManager NavigationManager

<PageTitle>Personal Médico | Veterinaria Génesis</PageTitle>

<div class="mb-6 flex justify-between items-center">
    <div>
        <h1 class="text-2xl font-bold text-gray-900">Directorio de Personal Médico</h1>
        <p class="text-sm text-gray-500">Gestiona veterinarios, asistentes y demás trabajadores de la clínica.</p>
    </div>
    
    <button @onclick='() => NavigationManager.NavigateTo("/trabajadores/crear")' class="bg-indigo-600 hover:bg-indigo-700 text-white px-4 py-2 rounded-lg shadow-md font-medium transition-colors flex items-center">
        <i class="fas fa-plus mr-2"></i> Nuevo Trabajador
    </button>
</div>

<div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
    @foreach (var trabajador in AppState.Trabajadores)
    {
        <div class="bg-white rounded-xl shadow-sm border border-gray-100 overflow-hidden hover:shadow-md transition-shadow">
            <div class="p-6">
                <div class="flex items-center justify-between mb-4">
                    <div class="flex items-center">
                        <div class="h-12 w-12 rounded-full @(trabajador.Rol == "Veterinario" ? "bg-indigo-100 text-indigo-600" : "bg-teal-100 text-teal-600") flex items-center justify-center text-lg font-bold">
                            @(trabajador.Nombres.FirstOrDefault())@(trabajador.Apellidos.FirstOrDefault())
                        </div>
                        <div class="ml-4">
                            <h3 class="text-lg font-medium text-gray-900">@trabajador.Nombres @trabajador.Apellidos</h3>
                            <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium @(trabajador.Rol == "Veterinario" ? "bg-indigo-100 text-indigo-800" : "bg-teal-100 text-teal-800")">
                                @trabajador.Rol
                            </span>
                        </div>
                    </div>
                </div>
                
                <div class="space-y-2 text-sm text-gray-600">
                    <div class="flex items-center">
                        <i class="fas fa-stethoscope w-5 text-gray-400"></i>
                        <span>Especialidad: @trabajador.Especialidad</span>
                    </div>
                    <div class="flex items-center">
                        <i class="fas fa-phone w-5 text-gray-400"></i>
                        <span>@trabajador.Telefono</span>
                    </div>
                </div>
            </div>
            <div class="bg-gray-50 px-6 py-3 border-t border-gray-100 flex justify-end space-x-2">
                <button class="text-blue-600 hover:text-blue-900 px-3 py-1 text-sm font-medium transition-colors" title="Editar">
                    <i class="fas fa-edit mr-1"></i> Editar
                </button>
                <button class="text-red-600 hover:text-red-900 px-3 py-1 text-sm font-medium transition-colors" title="Eliminar">
                    <i class="fas fa-trash-alt mr-1"></i> Eliminar
                </button>
            </div>
        </div>
    }
</div>

@code {
    protected override async Task OnInitializedAsync()
    {
        AppState.OnChange += StateHasChanged;
        await AppState.LoadTrabajadoresAsync();
    }

    public void Dispose()
    {
        AppState.OnChange -= StateHasChanged;
    }
}
