@page "/trabajadores/crear"
@page "/trabajadores/editar/{Id:guid}"
@using VeterinariaGenesis.Client.Services
@using VeterinariaGenesis.Domain.Entities
@inject AppStateService AppState
@inject NavigationManager NavigationManager

<PageTitle>@(Id == null ? "Nuevo Trabajador" : "Editar Trabajador") | Veterinaria Génesis</PageTitle>

<div class="mb-6 flex justify-between items-center">
    <div>
        <button @onclick="Volver" class="text-gray-500 hover:text-indigo-600 mb-2 flex items-center transition-colors">
            <i class="fas fa-arrow-left mr-2"></i> Volver al directorio
        </button>
        <h1 class="text-2xl font-bold text-gray-900">@(Id == null ? "Registrar Nuevo Trabajador" : "Editar Trabajador")</h1>
    </div>
</div>

<div class="bg-white rounded-xl shadow-sm border border-gray-100 overflow-hidden">
    <EditForm Model="trabajador" OnValidSubmit="GuardarTrabajador">
        <div class="p-6">
            @if (!string.IsNullOrEmpty(errorMessage))
            {
                <div class="mb-6 p-4 bg-red-50 border-l-4 border-red-500 text-red-700 flex items-center">
                    <i class="fas fa-exclamation-circle mr-3"></i>
                    <span>@errorMessage</span>
                </div>
            }

            <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                <div class="space-y-4">
                    <h3 class="text-lg font-medium text-gray-900 border-b pb-2">Datos Personales</h3>
                    
                    <div>
                        <label class="block text-sm font-medium text-gray-700 mb-1">Nombres</label>
                        <InputText @bind-Value="trabajador.Nombres" class="w-full pl-3 pr-3 py-2 border border-gray-200 rounded-lg text-sm focus:outline-none focus:ring-1 focus:ring-indigo-500 focus:border-indigo-500" required />
                    </div>
                    
                    <div>
                        <label class="block text-sm font-medium text-gray-700 mb-1">Apellidos</label>
                        <InputText @bind-Value="trabajador.Apellidos" class="w-full pl-3 pr-3 py-2 border border-gray-200 rounded-lg text-sm focus:outline-none focus:ring-1 focus:ring-indigo-500 focus:border-indigo-500" required />
                    </div>
                    
                    <div>
                        <label class="block text-sm font-medium text-gray-700 mb-1">Teléfono</label>
                        <InputText @bind-Value="trabajador.Telefono" class="w-full pl-3 pr-3 py-2 border border-gray-200 rounded-lg text-sm focus:outline-none focus:ring-1 focus:ring-indigo-500 focus:border-indigo-500" required />
                    </div>
                </div>
                
                <div class="space-y-4">
                    <h3 class="text-lg font-medium text-gray-900 border-b pb-2">Datos Laborales</h3>
                    
                    <div>
                        <label class="block text-sm font-medium text-gray-700 mb-1">Rol / Puesto</label>
                        <InputSelect @bind-Value="trabajador.Rol" class="block w-full pl-3 pr-10 py-2 border border-gray-200 rounded-lg text-sm focus:outline-none focus:ring-1 focus:ring-indigo-500 focus:border-indigo-500 bg-white">
                            <option value="">Seleccionar...</option>
                            <option value="Veterinario">Veterinario</option>
                            <option value="Asistente">Asistente Médico</option>
                            <option value="Recepcionista">Recepcionista</option>
                            <option value="Administrador">Administrador</option>
                        </InputSelect>
                    </div>
                    
                    <div>
                        <label class="block text-sm font-medium text-gray-700 mb-1">Especialidad</label>
                        <InputText @bind-Value="trabajador.Especialidad" class="w-full pl-3 pr-3 py-2 border border-gray-200 rounded-lg text-sm focus:outline-none focus:ring-1 focus:ring-indigo-500 focus:border-indigo-500" placeholder="Ej. Cirugía, Dermatología..." />
                    </div>
                    
                    <div>
                        <label class="block text-sm font-medium text-gray-700 mb-1">Salario Base ($)</label>
                        <InputNumber @bind-Value="trabajador.SalarioBase" class="w-full pl-3 pr-3 py-2 border border-gray-200 rounded-lg text-sm focus:outline-none focus:ring-1 focus:ring-indigo-500 focus:border-indigo-500" />
                    </div>
                </div>
            </div>
        </div>
        
        <div class="bg-gray-50 px-6 py-4 border-t border-gray-100 flex justify-end space-x-3">
            <button type="button" @onclick="Volver" class="px-4 py-2 border border-gray-300 rounded-lg text-sm font-medium text-gray-700 hover:bg-gray-50 transition-colors" disabled="@isSaving">
                Cancelar
            </button>
            <button type="submit" class="px-4 py-2 bg-indigo-600 border border-transparent rounded-lg text-sm font-medium text-white hover:bg-indigo-700 shadow-sm transition-colors flex items-center" disabled="@isSaving">
                @if (isSaving)
                {
                    <i class="fas fa-spinner fa-spin mr-2"></i>
                    <span>Guardando...</span>
                }
                else
                {
                    <i class="fas fa-save mr-2"></i>
                    <span>@(Id == null ? "Guardar Trabajador" : "Guardar Cambios")</span>
                }
            </button>
        </div>
    </EditForm>
</div>

@code {
    [Parameter] public Guid? Id { get; set; }
    private Trabajador trabajador = new Trabajador();
    private string errorMessage = "";
    private bool isSaving = false;

    protected override async Task OnInitializedAsync()
    {
        if (Id != null)
        {
            var existing = AppState.Trabajadores.FirstOrDefault(t => t.Id == Id);
            if (existing != null)
            {
                trabajador = new Trabajador
                {
                    Id = existing.Id,
                    Nombres = existing.Nombres,
                    Apellidos = existing.Apellidos,
                    Telefono = existing.Telefono,
                    Rol = existing.Rol,
                    Especialidad = existing.Especialidad,
                    SalarioBase = existing.SalarioBase
                };
            }
        }
    }

    private async Task GuardarTrabajador()
    {
        errorMessage = "";
        isSaving = true;
        
        bool success;
        if (Id == null)
            success = await AppState.AddTrabajadorAsync(trabajador);
        else
            success = await AppState.UpdateTrabajadorAsync(trabajador);
        
        isSaving = false;
        
        if (success)
        {
            NavigationManager.NavigateTo("trabajadores");
        }
        else
        {
            errorMessage = "No se pudo guardar la información. Por favor, intenta de nuevo.";
        }
    }

    private void Volver()
    {
        NavigationManager.NavigateTo("trabajadores");
    }
}
