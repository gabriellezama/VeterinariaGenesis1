                                                <p class="text-xs font-bold text-gray-900">@activity.Title</p>
                                                <p class="text-[10px] text-gray-500">@activity.Description</p>
                                                <p class="text-[9px] text-indigo-400 mt-1">Hace un momento</p>
                                            </div>
                                        </div>
