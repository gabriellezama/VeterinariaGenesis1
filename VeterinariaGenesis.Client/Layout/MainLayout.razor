@code {
    private bool isMobileMenuOpen = false;
    private bool isDarkMode = false;
    private string searchQuery = "";

    private void ToggleMobileMenu() => isMobileMenuOpen = !isMobileMenuOpen;

    private void ExecuteSearch()
    {
        var relativeUri = NavigationManager.ToBaseRelativePath(NavigationManager.Uri);
        var path = relativeUri.Split('?')[0];

        if (string.IsNullOrWhiteSpace(searchQuery))
        {
            if (!string.IsNullOrEmpty(path))
            {
                NavigationManager.NavigateTo(path);
            }
        }
        else
        {
            if (string.IsNullOrEmpty(path))
            {
                NavigationManager.NavigateTo($"clientes?q={Uri.EscapeDataString(searchQuery)}");
            }
            else
            {
                NavigationManager.NavigateTo($"{path}?q={Uri.EscapeDataString(searchQuery)}");
            }
        }
    }

    private string GetSearchPlaceholder()
    {
        var relativeUri = NavigationManager.ToBaseRelativePath(NavigationManager.Uri).ToLower();
        
        if (relativeUri.Contains("clientes"))
            return "Buscar clientes...";
        if (relativeUri.Contains("citas"))
            return "Buscar citas...";
        if (relativeUri.Contains("historial"))
            return "Buscar en historial médico...";
        if (relativeUri.Contains("trabajadores") || relativeUri.Contains("personal"))
            return "Buscar personal...";
        if (relativeUri.Contains("productos") || relativeUri.Contains("inventario"))
            return "Buscar productos...";
        if (relativeUri.Contains("facturacion"))
            return "Buscar facturas...";
        if (relativeUri.Contains("proveedores"))
            return "Buscar proveedores...";
            
        return "Buscar pacientes o clientes...";
    }

    private bool ShouldShowSearchBar()
    {
        var relativeUri = NavigationManager.ToBaseRelativePath(NavigationManager.Uri).ToLower();
        if (relativeUri.Contains("contabilidad"))
            return false;
        return true;
    }

    protected override void OnInitialized()
    {
        AppState.OnChange += HandleStateChanged;
        NavigationManager.LocationChanged += OnLocationChanged;
        UpdateSearchQueryFromUri();
    }

    private void OnLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        UpdateSearchQueryFromUri();
        InvokeAsync(StateHasChanged);
    }

    private void UpdateSearchQueryFromUri()
    {
        var uri = NavigationManager.Uri;
        var queryIndex = uri.IndexOf('?');
        if (queryIndex >= 0)
        {
            var queryString = uri.Substring(queryIndex + 1);
            var parts = queryString.Split('&');
            var qParam = parts.FirstOrDefault(p => p.StartsWith("q="));
            if (qParam != null)
            {
                searchQuery = Uri.UnescapeDataString(qParam.Substring(2));
            }
            else
            {
                searchQuery = "";
            }
        }
        else
        {
            searchQuery = "";
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            if (!AppState.IsLoggedIn && !NavigationManager.Uri.Contains("/login"))
            {
                NavigationManager.NavigateTo("login");
            }
            try
            {
                var theme = await JS.InvokeAsync<string>("themeManager.getTheme");
                isDarkMode = theme == "dark";
                StateHasChanged();
            }
            catch (Exception ex)
            {
                Console.WriteLine($"Error init theme: {ex.Message}");
            }
        }
    }

    private async Task ToggleTheme()
    {
        isDarkMode = !isDarkMode;
        await JS.InvokeVoidAsync("themeManager.setTheme", isDarkMode ? "dark" : "light");
    }

    private async Task CargarDatosDemo()
    {
        bool confirmado = await JS.InvokeAsync<bool>("confirm", "¿Deseas cargar la base de datos con registros reales de demostración (clientes, gatos, perros, productos y facturas)? Esto solo se aplicará si la base de datos está vacía.");
        if (confirmado)
        {
            bool exito = await AppState.SeedDemoDataAsync();
            if (exito)
            {
                await JS.InvokeVoidAsync("alert", "¡Datos de demostración cargados exitosamente!");
                NavigationManager.NavigateTo(NavigationManager.Uri, forceLoad: true);
            }
            else
            {
                await JS.InvokeVoidAsync("alert", "No se cargaron datos (es posible que la base de datos ya tenga registros).");
            }
        }
    }

    private void HandleStateChanged()
    {
        InvokeAsync(StateHasChanged);
    }

    private void HandleLogout()
    {
        AppState.Logout();
    }

    private bool showNotifications = false;
    private int notificationsSeenCount = 0;

    private void ToggleNotifications() => showNotifications = !showNotifications;

    private void MarkAsRead()
    {
        notificationsSeenCount = RecentActivitiesRaw.Count();
        showNotifications = false;
    }

    private List<ActivityItem> RecentActivitiesRaw
    {
        get
        {
            var list = new List<ActivityItem>();
            
            // Simular notificaciones basadas en datos reales
            if (AppState.Clientes != null && AppState.Clientes.Any())
            {
                var lastCliente = AppState.Clientes.LastOrDefault();
                if (lastCliente != null)
                {
                    list.Add(new ActivityItem { 
                        Title = "Nuevo Cliente", 
                        Description = $"{(lastCliente.Nombres ?? "Nuevo cliente")} se ha unido.", 
                        Icon = "fa-user-plus", 
                        Color = "bg-indigo-500" 
                    });
                }
            }
            if (AppState.Mascotas != null && AppState.Mascotas.Any())
            {
                var lastMascota = AppState.Mascotas.LastOrDefault();
                if (lastMascota != null)
                {
                    list.Add(new ActivityItem { 
                        Title = "Nueva Mascota", 
                        Description = $"{(lastMascota.Nombre ?? "Nueva mascota")} fue registrada.", 
                        Icon = "fa-paw", 
                        Color = "bg-amber-500" 
                    });
                }
            }
                
            if (AppState.Trabajadores.Any())
                list.Add(new ActivityItem { Title = "Personal Actualizado", Description = "Se registró un nuevo profesional.", Icon = "fa-user-md", Color = "bg-teal-500" });

            return list;
        }
    }

    private List<ActivityItem> RecentActivities => notificationsSeenCount >= RecentActivitiesRaw.Count() ? new() : RecentActivitiesRaw;

    public class ActivityItem
    {
        public string Title { get; set; } = "";
        public string Description { get; set; } = "";
        public string Icon { get; set; } = "";
        public string Color { get; set; } = "";
    }

    public void Dispose()
    {
        AppState.OnChange -= HandleStateChanged;
        NavigationManager.LocationChanged -= OnLocationChanged;
    }
}
