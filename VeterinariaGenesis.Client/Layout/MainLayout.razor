@inherits LayoutComponentBase
@implements IDisposable
@using VeterinariaGenesis.Client.Services
@inject AppStateService AppState
@inject NavigationManager NavigationManager
@if (!AppState.IsLoggedIn)
{
    // Guard: No mostrar el layout si no está autenticado
    // La redirección ocurre en OnInitialized
}
else
{
<div class="flex h-screen bg-gray-100 font-sans">
    <!-- Sidebar -->
    <aside class="w-64 bg-slate-900 text-white flex flex-col hidden md:flex">
        <!-- Logo -->
        <div class="h-20 flex items-center justify-center bg-slate-950 border-b border-slate-800">
            <a href="/" class="flex items-center justify-center">
                <img src="images/logo.png" alt="Veterinaria Génesis Logo" class="h-14 w-auto drop-shadow-md rounded-full bg-white p-1" onerror="this.onerror=null; this.src='https://via.placeholder.com/150?text=Logo';" />
            </a>
        </div>
        
        <!-- Menú de Navegación -->
        <nav class="flex-1 overflow-y-auto py-4">
            <ul class="space-y-1 px-3">
                <li>
                    <NavLink class="flex items-center px-4 py-3 text-slate-300 hover:bg-slate-800 hover:text-white rounded-lg transition-colors group" href="" Match="NavLinkMatch.All">
                        <i class="fas fa-chart-pie w-6 text-slate-400 group-hover:text-indigo-400"></i>
                        <span class="font-medium">Dashboard</span>
                    </NavLink>
                </li>
                <li>
                    <NavLink class="flex items-center px-4 py-3 text-slate-300 hover:bg-slate-800 hover:text-white rounded-lg transition-colors group" href="clientes">
                        <i class="fas fa-users w-6 text-slate-400 group-hover:text-indigo-400"></i>
                        <span class="font-medium">Clientes</span>
                    </NavLink>
                </li>
                <li>
                    <NavLink class="flex items-center px-4 py-3 text-slate-300 hover:bg-slate-800 hover:text-white rounded-lg transition-colors group" href="historial-clinico/00000000-0000-0000-0000-000000000001">
                        <i class="fas fa-history w-6 text-slate-400 group-hover:text-indigo-400"></i>
                        <span class="font-medium">Historial Médico</span>
                    </NavLink>
                </li>
                <li>
                    <NavLink href="/trabajadores" class="flex items-center px-4 py-3 text-slate-300 hover:bg-slate-800 hover:text-white rounded-lg transition-colors group">
                        <i class="fas fa-user-md w-6 text-slate-400 group-hover:text-indigo-400"></i>
                        <span class="font-medium">Personal</span>
                    </NavLink>
                </li>
                <li>
                    <NavLink href="/productos" class="flex items-center px-4 py-3 text-slate-300 hover:bg-slate-800 hover:text-white rounded-lg transition-colors group">
                        <i class="fas fa-box-open w-6 text-slate-400 group-hover:text-indigo-400"></i>
                        <span class="font-medium">Inventario</span>
                    </NavLink>
                </li>
                <li>
                    <NavLink href="/facturacion" class="flex items-center px-4 py-3 text-slate-300 hover:bg-slate-800 hover:text-white rounded-lg transition-colors group">
                        <i class="fas fa-file-invoice-dollar w-6 text-slate-400 group-hover:text-indigo-400"></i>
                        <span class="font-medium">Facturación</span>
                    </NavLink>
                </li>
                <li>
                    <NavLink href="/contabilidad" class="flex items-center px-4 py-3 text-slate-300 hover:bg-slate-800 hover:text-white rounded-lg transition-colors group">
                        <i class="fas fa-chart-line w-6 text-slate-400 group-hover:text-indigo-400"></i>
                        <span class="font-medium">Contabilidad</span>
                    </NavLink>
                </li>
            </ul>
        </nav>
        
        <!-- Usuario Inferior -->
        <div class="p-4 bg-slate-950 border-t border-slate-800">
            <div class="flex items-center justify-between">
                <div class="flex items-center">
                    <div class="w-10 h-10 rounded-full bg-indigo-600 flex items-center justify-center text-white font-bold">
                        <i class="fas fa-user-shield text-sm"></i>
                    </div>
                    <div class="ml-3">
                        <p class="text-sm font-medium text-white">Administrador</p>
                        <p class="text-xs text-slate-400">Sesión activa</p>
                    </div>
                </div>
                <button @onclick="HandleLogout" title="Cerrar Sesión" class="text-slate-400 hover:text-red-400 transition-colors ml-2">
                    <i class="fas fa-sign-out-alt"></i>
                </button>
            </div>
        </div>
    </aside>

    <!-- Contenido Principal -->
    <div class="flex-1 flex flex-col overflow-hidden">
        <!-- Topbar -->
        <header class="h-16 bg-white shadow-sm flex items-center justify-between px-6 z-10">
            <!-- Menú hamburguesa (móvil) -->
            <button class="md:hidden text-gray-500 hover:text-gray-700">
                <i class="fas fa-bars text-xl"></i>
            </button>
            
            <!-- Buscador -->
            <div class="hidden md:flex flex-1 items-center ml-4">
                <div class="relative w-64">
                    <span class="absolute inset-y-0 left-0 pl-3 flex items-center">
                        <i class="fas fa-search text-gray-400"></i>
                    </span>
                    <input type="text" class="block w-full pl-10 pr-3 py-2 border border-gray-200 rounded-lg text-sm placeholder-gray-500 focus:outline-none focus:ring-1 focus:ring-indigo-500 focus:border-indigo-500" placeholder="Buscar pacientes o clientes...">
                </div>
            </div>
            
            <!-- Acciones Topbar -->
            <div class="flex items-center space-x-4">
                <button @onclick='() => NavigationManager.NavigateTo("clientes")' class="text-gray-400 hover:text-indigo-600 relative">
                    <i class="far fa-bell text-xl"></i>
                    <span class="absolute top-0 right-0 -mt-1 -mr-1 flex h-4 w-4">
                        <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-red-400 opacity-75"></span>
                        <span class="relative inline-flex rounded-full h-4 w-4 bg-red-500 text-white text-[10px] items-center justify-center font-bold border border-white">3</span>
                    </span>
                </button>
            </div>
        </header>

        <!-- Área Scrolleable -->
        <main class="flex-1 overflow-y-auto bg-gray-50 p-6">
            @Body
        </main>
    </div>
</div>
}

@code {
    protected override void OnInitialized()
    {
        AppState.OnChange += HandleStateChanged;
        if (!AppState.IsLoggedIn)
        {
            NavigationManager.NavigateTo("login", forceLoad: false);
        }
    }

    private void HandleStateChanged()
    {
        if (!AppState.IsLoggedIn)
        {
            NavigationManager.NavigateTo("login", forceLoad: false);
        }
        InvokeAsync(StateHasChanged);
    }

    private void HandleLogout()
    {
        AppState.Logout();
    }

    public void Dispose()
    {
        AppState.OnChange -= HandleStateChanged;
    }
}
